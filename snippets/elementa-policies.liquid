{% comment %}
  Elementa Studio - Official Store Policies Hub
  Dynamic interactive policy viewer for Shipping, Privacy, Refund & Terms
{% endcomment %}

{% assign current_path = request.path | downcase %}
{% assign active_policy = 'shipping' %}
{% if current_path contains 'privacy' %}
  {% assign active_policy = 'privacy' %}
{% elsif current_path contains 'refund' or current_path contains 'return' %}
  {% assign active_policy = 'refund' %}
{% elsif current_path contains 'term' %}
  {% assign active_policy = 'terms' %}
{% elsif current_path contains 'shipping' %}
  {% assign active_policy = 'shipping' %}
{% endif %}

<section class="elementa-policy-hub" id="elementa-policy-hub">
  <!-- Policy Hero Header -->
  <div class="policy-hero">
    <div class="policy-container">
      <div class="policy-breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="sep">/</span>
        <span class="current">Store Policies</span>
      </div>
      <div class="policy-badge">
        <i class="fa-solid fa-shield-check"></i> Official Elementa Policies
      </div>
      <h1 class="policy-main-title">Store Guidelines &amp; Customer Policies</h1>
      <p class="policy-subtitle">
        Transparent terms regarding custom manufacturing, PAN India shipping timelines, privacy safeguards, and order policies.
      </p>
      <div class="policy-meta">
        <span><i class="fa-regular fa-clock"></i> Effective Date: October 2026</span>
        <span>•</span>
        <span><i class="fa-regular fa-building"></i> Elementa Studio</span>
      </div>
    </div>
  </div>

  <!-- Policy Body Container -->
  <div class="policy-main-wrap">
    <div class="policy-container">
      <div class="policy-layout-grid">
        
        <!-- Navigation Sidebar -->
        <aside class="policy-sidebar">
          <div class="policy-sidebar-inner">
            <div class="sidebar-title">Table of Policies</div>
            <nav class="policy-nav" aria-label="Policy Navigation">
              <button type="button" class="policy-nav-item {% if active_policy == 'shipping' %}active{% endif %}" data-target="shipping">
                <span class="icon-wrap"><i class="fa-solid fa-truck-fast"></i></span>
                <span class="item-text">
                  <span class="item-title">Shipping Policy</span>
                  <span class="item-sub">Timelines &amp; PAN India delivery</span>
                </span>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
              </button>

              <button type="button" class="policy-nav-item {% if active_policy == 'privacy' %}active{% endif %}" data-target="privacy">
                <span class="icon-wrap"><i class="fa-solid fa-lock"></i></span>
                <span class="item-text">
                  <span class="item-title">Privacy Policy</span>
                  <span class="item-sub">Data security &amp; artwork usage</span>
                </span>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
              </button>

              <button type="button" class="policy-nav-item {% if active_policy == 'refund' %}active{% endif %}" data-target="refund">
                <span class="icon-wrap"><i class="fa-solid fa-rotate-left"></i></span>
                <span class="item-text">
                  <span class="item-title">Refund &amp; Return Policy</span>
                  <span class="item-sub">Custom made-to-order terms</span>
                </span>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
              </button>

              <button type="button" class="policy-nav-item {% if active_policy == 'terms' %}active{% endif %}" data-target="terms">
                <span class="icon-wrap"><i class="fa-solid fa-file-contract"></i></span>
                <span class="item-text">
                  <span class="item-title">Terms of Service</span>
                  <span class="item-sub">Prepaid orders &amp; user terms</span>
                </span>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
              </button>
            </nav>

            <!-- Support Assistance Card -->
            <div class="policy-help-card">
              <div class="help-icon"><i class="fa-solid fa-headset"></i></div>
              <div class="help-title">Have Questions?</div>
              <p class="help-desc">Our customer experience team is here to assist with any questions regarding your orders.</p>
              <a href="mailto:contact@shopelementa.in" class="help-email-btn">
                <i class="fa-solid fa-envelope"></i> contact@shopelementa.in
              </a>
              <a href="https://api.whatsapp.com/send?phone=919596681555&text=Hi%20Elementa%2C%20I%20have%20an%20inquiry%20regarding%20my%20order" target="_blank" rel="noopener noreferrer" class="help-email-btn" style="background: #25D366; color: #ffffff; border-color: #25D366; margin-top: 8px;">
                <i class="fa-brands fa-whatsapp"></i> +91 9596681555
              </a>
              <div class="help-hours">Mon – Fri | 10:00 AM – 6:00 PM IST</div>
            </div>
          </div>
        </aside>

        <!-- Content Area -->
        <main class="policy-content-area">

          <!-- 1. SHIPPING POLICY -->
          <article class="policy-panel {% if active_policy == 'shipping' %}active{% endif %}" id="panel-shipping" data-policy="shipping">
            <div class="panel-header">
              <span class="panel-tag"><i class="fa-solid fa-truck-fast"></i> Logistics &amp; Dispatch</span>
              <h2 class="panel-title">Shipping Policy</h2>
              <div class="panel-lead">
                At Elementa, most of our products are customized or made to order. Therefore, we require a few business days to prepare, print, quality-check and pack your order before dispatch. We currently ship PAN India to serviceable PIN codes using trusted third-party courier and logistics partners. Standard delivery timelines apply to regular shipping. If you choose express shipping, additional charges will apply and will be displayed at checkout.
              </div>
            </div>

            <!-- Highlights Grid -->
            <div class="policy-features-grid">
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                <div class="pf-val">3–5 Business Days</div>
                <div class="pf-label">Dispatch Time</div>
                <p class="pf-desc">Printing, curing, and rigorous quality check before packing.</p>
              </div>
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-location-dot"></i></div>
                <div class="pf-val">7–10 Business Days</div>
                <div class="pf-label">Standard Delivery</div>
                <p class="pf-desc">PAN India delivery across all serviceable postal PIN codes.</p>
              </div>
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-bolt"></i></div>
                <div class="pf-val">Express Option</div>
                <div class="pf-label">Priority Shipping</div>
                <p class="pf-desc">Calculated and clearly displayed at checkout if available.</p>
              </div>
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-box-open"></i></div>
                <div class="pf-val">Doorstep Delivery</div>
                <div class="pf-label">Trusted Couriers</div>
                <p class="pf-desc">Direct delivery using premier domestic logistics partners.</p>
              </div>
            </div>

            <div class="panel-body">
              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-calendar-check"></i> Dispatch Time</h3>
                <p>
                  Orders are usually dispatched within <strong>3–5 business days</strong> from the date of successful payment. As our products are customized and made to order, dispatch times may vary depending on the product, quantity, customization requirements and order volume.
                </p>
                <p>
                  Our order processing and dispatch operations run <strong>Monday to Friday during standard business hours</strong>. We remain closed on national/public holidays. Orders placed during weekends or holidays will be processed on the next working day. During holidays or other periods that may affect operations, we make reasonable efforts to keep any delays to a minimum.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-route"></i> Delivery Time</h3>
                <p>
                  Once dispatched, standard delivery usually takes approximately <strong>7–10 business days</strong>, depending on the delivery location and courier serviceability.
                </p>
                <div class="policy-notice-box info">
                  <i class="fa-solid fa-circle-info"></i>
                  <div>
                    Delivery timelines are estimates and may be affected by national/public holidays, weather conditions, courier delays, strikes, high-volume periods or other unforeseen circumstances beyond our control.
                  </div>
                </div>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-receipt"></i> Shipping Charges</h3>
                <p>
                  Applicable shipping charges will be calculated and displayed at checkout based on your order and delivery location. Any express shipping charges, where applicable, will be additional to the standard shipping charges.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-house-chimney"></i> Doorstep Delivery</h3>
                <p>
                  Orders are delivered to the shipping address provided by the customer at checkout using third-party courier services.
                </p>
                <div class="policy-notice-box alert">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                  <div>
                    Please ensure that your complete address, PIN code and contact number are entered correctly when placing your order. <strong>Elementa will not be responsible for delays or failed deliveries caused by incorrect or incomplete shipping information provided by the customer.</strong>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <!-- 2. PRIVACY POLICY -->
          <article class="policy-panel {% if active_policy == 'privacy' %}active{% endif %}" id="panel-privacy" data-policy="privacy">
            <div class="panel-header">
              <span class="panel-tag"><i class="fa-solid fa-user-shield"></i> Data Protection</span>
              <h2 class="panel-title">Privacy Policy</h2>
              <div class="panel-lead">
                At Elementa, we value your privacy and are committed to protecting your personal information. When you place an order or use our website, we may collect information such as your name, email address, phone number, shipping/billing address, order details, and designs or images uploaded for customization.
              </div>
            </div>

            <!-- Highlights Grid -->
            <div class="policy-features-grid">
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div class="pf-val">Zero Sale of Data</div>
                <div class="pf-label">Strict Privacy</div>
                <p class="pf-desc">Elementa never sells or rents your personal info to any third party.</p>
              </div>
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-file-image"></i></div>
                <div class="pf-val">Custom Artwork</div>
                <div class="pf-label">Order Use Only</div>
                <p class="pf-desc">Uploaded files and logos are used solely to fulfill your custom order.</p>
              </div>
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-credit-card"></i></div>
                <div class="pf-val">Encrypted Gateway</div>
                <div class="pf-label">Zero Card Storage</div>
                <p class="pf-desc">No raw card credentials or UPI PINs are ever stored on our servers.</p>
              </div>
              <div class="p-feature-card">
                <div class="pf-icon"><i class="fa-solid fa-cookie-bite"></i></div>
                <div class="pf-val">Smart Cookies</div>
                <div class="pf-label">Experience Tuning</div>
                <p class="pf-desc">Used strictly to enhance shopping experience and cart persistence.</p>
              </div>
            </div>

            <div class="panel-body">
              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-bullseye"></i> How We Use Your Information</h3>
                <p>We use the information collected from you only to:</p>
                <ul class="policy-checklist">
                  <li><i class="fa-solid fa-check"></i> Process and fulfil your orders</li>
                  <li><i class="fa-solid fa-check"></i> Create your customized products</li>
                  <li><i class="fa-solid fa-check"></i> Arrange payment, shipping and delivery</li>
                  <li><i class="fa-solid fa-check"></i> Provide dedicated customer support</li>
                  <li><i class="fa-solid fa-check"></i> Improve our website and services</li>
                </ul>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-handshake"></i> Service Providers &amp; Third Parties</h3>
                <p>
                  Your information may be shared with trusted service providers such as payment gateways, courier partners and website service providers only where necessary to process and fulfil your order. <strong>Elementa does not sell or rent your personal information to third parties.</strong>
                </p>
                <p>
                  Any designs, photographs, logos or other files uploaded for customization are used for fulfilling your order and related customer support.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-lock"></i> Payment Security</h3>
                <p>
                  Payments are processed through secure third-party payment providers, and <strong>Elementa does not directly store your complete card, UPI PIN or other sensitive payment credentials.</strong>
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-cookie"></i> Cookies</h3>
                <p>
                  Our website may use cookies to improve your browsing and shopping experience.
                </p>
              </div>

              <div class="content-section contact-highlight">
                <h3 class="section-title"><i class="fa-solid fa-envelope-open-text"></i> Privacy Contact &amp; Requests</h3>
                <p>
                  For any privacy-related questions or requests, please contact us at:
                </p>
                <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
                  <a href="mailto:contact@shopelementa.in" class="policy-inline-email">
                    <i class="fa-solid fa-envelope"></i> contact@shopelementa.in
                  </a>
                  <a href="https://api.whatsapp.com/send?phone=919596681555&text=Hi%20Elementa%2C%20I%20have%20an%20inquiry%20regarding%20privacy" target="_blank" rel="noopener noreferrer" class="policy-inline-email" style="color: #15803d;">
                    <i class="fa-brands fa-whatsapp"></i> +91 9596681555
                  </a>
                </div>
              </div>
            </div>
          </article>

          <!-- 3. REFUND & RETURN POLICY -->
          <article class="policy-panel {% if active_policy == 'refund' %}active{% endif %}" id="panel-refund" data-policy="refund">
            <div class="panel-header">
              <span class="panel-tag warning"><i class="fa-solid fa-ban"></i> Return Terms</span>
              <h2 class="panel-title">Refund &amp; Return Policy</h2>
              <div class="panel-lead">
                Thank you for shopping with Elementa. We hope you are happy with your purchase.
              </div>
            </div>

            <!-- Prominent Warning Notice -->
            <div class="policy-callout-hero">
              <div class="callout-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
              <div class="callout-content">
                <h3>Strict No Return &amp; No Refund Policy</h3>
                <p>
                  As all our products are customized and printed on demand, we follow a strict <strong>No Return and No Refund Policy</strong>.
                </p>
                <p class="callout-sub">
                  Once an order has been placed and confirmed, it <strong>cannot be returned, exchanged, cancelled or refunded</strong>.
                </p>
              </div>
            </div>

            <div class="panel-body">
              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-circle-question"></i> Why are custom orders non-returnable?</h3>
                <p>
                  Every piece crafted by Elementa—from bespoke t-shirts and custom tumblers to stickers and personalized gift sets—is manufactured uniquely to your specifications, chosen design, uploaded artwork, and custom sizing. Because these custom items cannot be restocked or resold, all sales are final upon order confirmation.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-magnifying-glass"></i> Pre-Order Verification</h3>
                <p>
                  To ensure complete satisfaction, we strongly advise customers to:
                </p>
                <ul class="policy-checklist">
                  <li><i class="fa-solid fa-check"></i> Thoroughly verify uploaded artwork, image clarity, and spelling prior to submitting your order.</li>
                  <li><i class="fa-solid fa-check"></i> Review our sizing charts carefully for all apparel and merchandise.</li>
                  <li><i class="fa-solid fa-check"></i> Confirm that the recipient shipping address, PIN code, and phone number are accurate.</li>
                </ul>
              </div>

              <div class="content-section contact-highlight">
                <h3 class="section-title"><i class="fa-solid fa-envelope-circle-check"></i> Questions Regarding Your Order</h3>
                <p>
                  For any questions regarding your order or this policy, please contact us at:
                </p>
                <div class="contact-box">
                  <div class="contact-label">Customer Support:</div>
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="mailto:contact@shopelementa.in" class="policy-inline-email">
                      <i class="fa-solid fa-envelope"></i> contact@shopelementa.in
                    </a>
                    <a href="https://api.whatsapp.com/send?phone=919596681555&text=Hi%20Elementa%2C%20I%20have%20an%20inquiry%20regarding%20my%20order%20refund" target="_blank" rel="noopener noreferrer" class="policy-inline-email" style="color: #15803d;">
                      <i class="fa-brands fa-whatsapp"></i> +91 9596681555
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <!-- 4. TERMS OF SERVICE -->
          <article class="policy-panel {% if active_policy == 'terms' %}active{% endif %}" id="panel-terms" data-policy="terms">
            <div class="panel-header">
              <span class="panel-tag"><i class="fa-solid fa-scale-balanced"></i> Legal Agreement</span>
              <h2 class="panel-title">Terms of Service</h2>
              <div class="panel-lead">
                By accessing Elementa or placing an order through our website, you agree to the following Terms of Service.
              </div>
            </div>

            <div class="panel-body">
              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-palette"></i> Orders &amp; Customization</h3>
                <p>
                  Most Elementa products are customized and printed on demand. Customers are responsible for ensuring that all designs, text, sizes, quantities and other customization details submitted while placing an order are correct.
                </p>
                <div class="policy-notice-box info">
                  <i class="fa-solid fa-info-circle"></i>
                  <div>
                    Once an order has been confirmed and sent for processing, changes or cancellations cannot be made.
                  </div>
                </div>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-money-bill-wave"></i> Payments &amp; COD</h3>
                <p>
                  All orders must be prepaid using the payment options available at checkout. <strong>Cash on Delivery (COD) is currently not available.</strong> We may introduce COD in the future, and any changes will be reflected on our website.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-rotate-left"></i> Returns &amp; Refunds</h3>
                <p>
                  As our products are customized and printed on demand, we follow a strict <strong>No Return and No Refund Policy</strong>. Once an order has been placed and confirmed, it cannot be returned, exchanged, cancelled or refunded.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-truck"></i> Shipping &amp; Delivery</h3>
                <p>
                  We currently ship PAN India to serviceable PIN codes through third-party courier partners. Orders are generally dispatched within <strong>3–5 business days</strong>, and standard delivery usually takes approximately <strong>7–10 business days after dispatch</strong>.
                </p>
                <p>
                  Shipping charges are displayed at checkout. Express shipping may be available at an additional charge, which will also be displayed at checkout.
                </p>
                <p>
                  Delivery timelines are estimates and may vary due to courier delays, holidays, weather conditions or other circumstances beyond our control.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-copyright"></i> Customer-Uploaded Content</h3>
                <p>
                  By uploading any design, image, logo, text or artwork, you confirm that you have the necessary rights or permission to use it. <strong>Elementa will not be responsible for any copyright, trademark or other third-party claims arising from content provided by the customer.</strong>
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-shirt"></i> Product Appearance</h3>
                <p>
                  Minor variations in colour, placement, size or print appearance may occur due to differences in screens, materials and printing processes and will not be considered defects.
                </p>
              </div>

              <div class="content-section">
                <h3 class="section-title"><i class="fa-solid fa-pen-to-square"></i> Policy Updates</h3>
                <p>
                  We reserve the right to update our products, prices, policies and these Terms of Service when required.
                </p>
              </div>

              <div class="content-section contact-highlight">
                <h3 class="section-title"><i class="fa-solid fa-headset"></i> Contact Regarding Terms</h3>
                <p>
                  For any questions regarding these Terms, please contact us at:
                </p>
                <div class="contact-box">
                  <div class="contact-label">Customer Support:</div>
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="mailto:contact@shopelementa.in" class="policy-inline-email">
                      <i class="fa-solid fa-envelope"></i> contact@shopelementa.in
                    </a>
                    <a href="https://api.whatsapp.com/send?phone=919596681555&text=Hi%20Elementa%2C%20I%20have%20an%20inquiry%20regarding%20terms%20of%20service" target="_blank" rel="noopener noreferrer" class="policy-inline-email" style="color: #15803d;">
                      <i class="fa-brands fa-whatsapp"></i> +91 9596681555
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>

        </main>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     ELEMENTA LEGAL POLICIES HUB - HIGH-END DESIGN SYSTEM
     ========================================================= */
  .elementa-policy-hub {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: #f8fafc;
    color: #1e293b;
    min-height: 80vh;
    padding-bottom: 90px;
  }

  .policy-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero Section */
  .policy-hero {
    background: linear-gradient(135deg, #09131f 0%, #0f172a 50%, #16243b 100%);
    color: #ffffff;
    padding: 60px 0 50px 0;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .policy-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 184, 148, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .policy-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #94a3b8;
    margin-bottom: 20px;
    font-weight: 500;
  }
  .policy-breadcrumb a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s;
  }
  .policy-breadcrumb a:hover {
    color: #00b894;
  }
  .policy-breadcrumb .sep {
    color: #64748b;
  }
  .policy-breadcrumb .current {
    color: #00b894;
    font-weight: 600;
  }

  .policy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 184, 148, 0.15);
    border: 1px solid rgba(0, 184, 148, 0.4);
    color: #2ed573;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 16px;
  }

  .policy-main-title {
    font-size: 38px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.8px;
    line-height: 1.2;
    margin-bottom: 14px;
  }

  .policy-subtitle {
    font-size: 16px;
    color: #94a3b8;
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .policy-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: #64748b;
    font-weight: 500;
  }

  /* Main Layout */
  .policy-main-wrap {
    margin-top: -30px;
    position: relative;
    z-index: 2;
  }

  .policy-layout-grid {
    display: grid;
    grid-template-columns: 310px 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Sidebar */
  .policy-sidebar {
    position: sticky;
    top: 90px;
  }

  .policy-sidebar-inner {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    padding: 24px;
  }

  .sidebar-title {
    font-size: 12px;
