<script>
  (function() {
    function initPolicyHub() {
      var root = document.getElementById('elementa-policy-hub');
      if (!root) return;

      var navButtons = root.querySelectorAll('.policy-nav-item');
      var panels = root.querySelectorAll('.policy-panel');

      function switchPolicy(policyKey, updateUrl) {
        if (!policyKey) return;

        // Normalize
        policyKey = policyKey.toLowerCase().replace(/[^a-z]/g, '');
        if (policyKey.indexOf('ship') !== -1) policyKey = 'shipping';
        else if (policyKey.indexOf('priv') !== -1) policyKey = 'privacy';
        else if (policyKey.indexOf('ref') !== -1 || policyKey.indexOf('ret') !== -1) policyKey = 'refund';
        else if (policyKey.indexOf('term') !== -1) policyKey = 'terms';
        else policyKey = 'shipping';

        // Update nav items
        navButtons.forEach(function(btn) {
          if (btn.getAttribute('data-target') === policyKey) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        // Update panels
        panels.forEach(function(p) {
          if (p.getAttribute('data-policy') === policyKey) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });

        // Update URL hash / path if needed
        if (updateUrl) {
          var targetSlug = policyKey === 'terms' ? 'terms-of-service' : (policyKey + '-policy');
          if (window.history && window.history.pushState) {
            var newUrl = '/policies/' + targetSlug;
            window.history.pushState({ policy: policyKey }, '', newUrl);
          } else {
            window.location.hash = policyKey;
          }

          // Smooth scroll to panel header on mobile/desktop
          var targetPanel = document.getElementById('panel-' + policyKey);
          if (targetPanel) {
            var yOffset = -90;
            var y = targetPanel.getBoundingClientRect().top + window.pageYOffset + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
          }
        }
      }

      // Attach click events
      navButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var target = btn.getAttribute('data-target');
          switchPolicy(target, true);
        });
      });

      // Detect initial policy from URL pathname or hash
      var path = (window.location.pathname || '').toLowerCase();
      var hash = (window.location.hash || '').toLowerCase();
      
      var initialPolicy = 'shipping';
      if (path.indexOf('privacy') !== -1 || hash.indexOf('privacy') !== -1) {
        initialPolicy = 'privacy';
      } else if (path.indexOf('refund') !== -1 || path.indexOf('return') !== -1 || hash.indexOf('refund') !== -1 || hash.indexOf('return') !== -1) {
        initialPolicy = 'refund';
      } else if (path.indexOf('term') !== -1 || hash.indexOf('term') !== -1) {
        initialPolicy = 'terms';
      } else if (path.indexOf('shipping') !== -1 || hash.indexOf('shipping') !== -1) {
        initialPolicy = 'shipping';
      }

      switchPolicy(initialPolicy, false);

      // Intercept any policy links in footer/header if policy hub is on page
      document.querySelectorAll('a[href*="/policies/"]').forEach(function(anchor) {
        anchor.addEventListener('click', function(e) {
          if (root && (root.offsetParent !== null || window.getComputedStyle(root).display !== 'none')) {
            var href = (anchor.getAttribute('href') || '').toLowerCase();
            e.preventDefault();
            if (href.indexOf('privacy') !== -1) switchPolicy('privacy', true);
            else if (href.indexOf('refund') !== -1 || href.indexOf('return') !== -1) switchPolicy('refund', true);
            else if (href.indexOf('term') !== -1) switchPolicy('terms', true);
            else if (href.indexOf('shipping') !== -1) switchPolicy('shipping', true);
          }
        });
      });

      // Handle popstate for browser back/forward buttons
      window.addEventListener('popstate', function(e) {
        var p = (window.location.pathname || '').toLowerCase();
        if (p.indexOf('privacy') !== -1) switchPolicy('privacy', false);
        else if (p.indexOf('refund') !== -1 || p.indexOf('return') !== -1) switchPolicy('refund', false);
        else if (p.indexOf('term') !== -1) switchPolicy('terms', false);
        else if (p.indexOf('shipping') !== -1) switchPolicy('shipping', false);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPolicyHub);
    } else {
      initPolicyHub();
    }
  })();
</script>
