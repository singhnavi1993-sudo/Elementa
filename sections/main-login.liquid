<div class="login-section-wrapper" style="min-height: calc(100vh - 160px); background: #f1f5f9; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
  <div class="login-split-card" style="width: 100%; max-width: 1020px; min-height: 620px; background: #ffffff; border-radius: 24px; box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12); display: flex; overflow: hidden; position: relative; flex-wrap: wrap;">
    <!-- Left Hero Brand Panel -->
    <div class="login-left-panel" style="flex: 1; min-width: 320px; background: url('{{ 'login-gift-left-bg.jpg' | asset_url }}') center center / cover no-repeat; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 60px 40px 40px; text-align: center; color: #ffffff;">
      <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15, 23, 42, 0.55) 0%, rgba(15, 23, 42, 0.75) 100%); z-index: 1;"></div>
      <div class="login-left-content" style="position: relative; z-index: 2;">
        <h2 style="font-family: 'Great Vibes', cursive; font-size: 54px; font-weight: 400; color: #ffffff; margin-bottom: 14px; text-shadow: 0 4px 15px rgba(0, 0, 0, 0.6); line-height: 1.1;">Signature Gifts & Custom Merch</h2>
        <p style="font-size: 15px; font-weight: 500; color: #f8fafc; line-height: 1.6; max-width: 380px; margin: 0 auto; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);">Create custom corporate gift sets, premium t-shirts, and die-cut vinyl stickers with live approval previews.</p>
      </div>
    </div>

    <!-- Right Login / Register Form Panel -->
    <div class="login-right-panel" style="flex: 1; min-width: 320px; background: #ffffff; position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 40px 48px 30px; z-index: 2;">
      <div>
        <!-- Toggle Tabs -->
        <div class="auth-toggle-tabs" style="display: flex; background: #f1f5f9; border-radius: 12px; padding: 4px; margin: 0 auto 16px; max-width: 260px;">
          <button type="button" class="auth-tab-btn active" id="tab-login-btn" onclick="switchAuthTab('login')" style="flex: 1; padding: 9px 16px; border: none; background: #ffffff; font-size: 13px; font-weight: 800; color: #00a8ff; border-radius: 9px; cursor: pointer; box-shadow: 0 4px 12px rgba(0, 168, 255, 0.15);">LOG IN</button>
          <button type="button" class="auth-tab-btn" id="tab-register-btn" onclick="switchAuthTab('register')" style="flex: 1; padding: 9px 16px; border: none; background: transparent; font-size: 13px; font-weight: 800; color: #64748b; border-radius: 9px; cursor: pointer;">SIGN UP</button>
        </div>

        <!-- FORM 1: LOGIN -->
        <div id="auth-login-form-container">
          <h1 style="font-size: 34px; font-weight: 800; color: #00a8ff; font-family: 'Outfit', sans-serif; text-align: center; margin: 4px 0 2px; letter-spacing: -0.5px;">Sign In</h1>
          <p style="font-size: 13px; font-weight: 600; color: #64748b; text-align: center; margin-bottom: 22px;">Enter your credentials to access your saved designs and orders</p>

          {% form 'customer_login' %}
            {{ form.errors | default_errors }}
            <div style="position: relative; margin-bottom: 20px;">
              <span style="position: absolute; top: -9px; left: 18px; background: #ffffff; padding: 0 6px; font-size: 11px; font-weight: 700; color: #00a8ff; z-index: 3;">EMAIL</span>
              <div style="display: flex; align-items: center; border: 1.5px solid #7dd3fc; border-radius: 12px; padding: 12px 16px; background: #ffffff;">
                <i class="fa-regular fa-envelope" style="color: #64748b; font-size: 18px; margin-right: 12px;"></i>
                <input type="email" name="customer[email]" placeholder="user@shopelementa.in" required style="border: none; outline: none; width: 100%; font-size: 14px; color: #1e293b; font-weight: 600; background: transparent;">
              </div>
            </div>

            <div style="position: relative; margin-bottom: 12px;">
              <span style="position: absolute; top: -9px; left: 18px; background: #ffffff; padding: 0 6px; font-size: 11px; font-weight: 700; color: #00a8ff; z-index: 3;">PASSWORD</span>
              <div style="display: flex; align-items: center; border: 1.5px solid #7dd3fc; border-radius: 12px; padding: 12px 16px; background: #ffffff;">
                <i class="fa-solid fa-lock" style="color: #64748b; font-size: 18px; margin-right: 12px;"></i>
                <input type="password" name="customer[password]" placeholder="••••••••" required style="border: none; outline: none; width: 100%; font-size: 14px; color: #1e293b; font-weight: 600; background: transparent;">
              </div>
              <a href="#recover" style="display: block; text-align: right; font-size: 12px; font-weight: 600; color: #94a3b8; text-decoration: none; margin-top: 6px;">Forgot Password?</a>
            </div>

            <button type="submit" style="background: #00a8ff; color: #ffffff; border: none; padding: 12px 42px; font-size: 14px; font-weight: 800; border-radius: 8px; box-shadow: 0 6px 20px rgba(0, 168, 255, 0.35); text-transform: uppercase; cursor: pointer; display: block; margin: 20px auto 0; transition: all 0.2s ease;">SIGN IN</button>

            <!-- OR Divider -->
            <div style="display: flex; align-items: center; margin: 22px 0 16px;">
              <div style="flex: 1; height: 1px; background: #e2e8f0;"></div>
              <span style="font-size: 11px; font-weight: 800; color: #94a3b8; padding: 0 12px; text-transform: uppercase; letter-spacing: 0.5px;">OR SIGN IN WITH</span>
              <div style="flex: 1; height: 1px; background: #e2e8f0;"></div>
            </div>

            <!-- Social Login Buttons -->
            <div style="display: flex; gap: 12px; justify-content: center; max-width: 320px; margin: 0 auto;">
              <a href="https://account.shopelementa.in" class="btn-social-login" style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 10px 16px; border: 1.5px solid #e2e8f0; border-radius: 10px; background: #ffffff; color: #1e293b; font-size: 13px; font-weight: 700; text-decoration: none; transition: all 0.2s ease; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                <i class="fa-brands fa-google" style="color: #ea4335; font-size: 16px;"></i> Google
              </a>
              <a href="https://account.shopelementa.in" class="btn-social-login" style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 10px 16px; border: 1.5px solid #e2e8f0; border-radius: 10px; background: #ffffff; color: #1e293b; font-size: 13px; font-weight: 700; text-decoration: none; transition: all 0.2s ease; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                <i class="fa-brands fa-facebook" style="color: #1877f2; font-size: 16px;"></i> Facebook
              </a>
            </div>
          {% endform %}
        </div>

        <!-- FORM 2: REGISTER -->
        <div id="auth-register-form-container" style="display: none;">
          <h1 style="font-size: 34px; font-weight: 800; color: #00a8ff; font-family: 'Outfit', sans-serif; text-align: center; margin: 4px 0 2px; letter-spacing: -0.5px;">Create Account</h1>
          <p style="font-size: 13px; font-weight: 600; color: #64748b; text-align: center; margin-bottom: 22px;">Join Elementa to save customized artwork and track orders</p>

          {% form 'create_customer' %}
            {{ form.errors | default_errors }}
            <div style="display: flex; gap: 12px; margin-bottom: 16px;">
              <div style="flex: 1; position: relative;">
                <span style="position: absolute; top: -9px; left: 14px; background: #ffffff; padding: 0 4px; font-size: 10px; font-weight: 700; color: #00a8ff; z-index: 3;">FIRST NAME</span>
                <input type="text" name="customer[first_name]" placeholder="John" required style="width: 100%; border: 1.5px solid #7dd3fc; border-radius: 12px; padding: 10px 12px; font-size: 13px; font-weight: 600; outline: none;">
              </div>
              <div style="flex: 1; position: relative;">
                <span style="position: absolute; top: -9px; left: 14px; background: #ffffff; padding: 0 4px; font-size: 10px; font-weight: 700; color: #00a8ff; z-index: 3;">LAST NAME</span>
                <input type="text" name="customer[last_name]" placeholder="Doe" required style="width: 100%; border: 1.5px solid #7dd3fc; border-radius: 12px; padding: 10px 12px; font-size: 13px; font-weight: 600; outline: none;">
              </div>
            </div>

            <div style="position: relative; margin-bottom: 16px;">
              <span style="position: absolute; top: -9px; left: 18px; background: #ffffff; padding: 0 6px; font-size: 11px; font-weight: 700; color: #00a8ff; z-index: 3;">EMAIL</span>
              <input type="email" name="customer[email]" placeholder="user@elementa.com" required style="width: 100%; border: 1.5px solid #7dd3fc; border-radius: 12px; padding: 12px 16px; font-size: 14px; font-weight: 600; outline: none;">
            </div>

            <div style="position: relative; margin-bottom: 16px;">
              <span style="position: absolute; top: -9px; left: 18px; background: #ffffff; padding: 0 6px; font-size: 11px; font-weight: 700; color: #00a8ff; z-index: 3;">CREATE PASSWORD</span>
              <input type="password" name="customer[password]" placeholder="••••••••" required style="width: 100%; border: 1.5px solid #7dd3fc; border-radius: 12px; padding: 12px 16px; font-size: 14px; font-weight: 600; outline: none;">
            </div>

            <button type="submit" style="background: #00a8ff; color: #ffffff; border: none; padding: 12px 42px; font-size: 14px; font-weight: 800; border-radius: 8px; box-shadow: 0 6px 20px rgba(0, 168, 255, 0.35); text-transform: uppercase; cursor: pointer; display: block; margin: 16px auto 0;">CREATE ACCOUNT</button>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function switchAuthTab(mode) {
  var loginContainer = document.getElementById('auth-login-form-container');
  var regContainer = document.getElementById('auth-register-form-container');
  var btnLogin = document.getElementById('tab-login-btn');
  var btnReg = document.getElementById('tab-register-btn');

  if (mode === 'register') {
    if (loginContainer) loginContainer.style.display = 'none';
    if (regContainer) regContainer.style.display = 'block';
    if (btnLogin) {
      btnLogin.style.background = 'transparent';
      btnLogin.style.color = '#64748b';
      btnLogin.style.boxShadow = 'none';
    }
    if (btnReg) {
      btnReg.style.background = '#ffffff';
      btnReg.style.color = '#00a8ff';
      btnReg.style.boxShadow = '0 4px 12px rgba(0, 168, 255, 0.15)';
    }
  } else {
    if (regContainer) regContainer.style.display = 'none';
    if (loginContainer) loginContainer.style.display = 'block';
    if (btnReg) {
      btnReg.style.background = 'transparent';
      btnReg.style.color = '#64748b';
      btnReg.style.boxShadow = 'none';
    }
    if (btnLogin) {
      btnLogin.style.background = '#ffffff';
      btnLogin.style.color = '#00a8ff';
      btnLogin.style.boxShadow = '0 4px 12px rgba(0, 168, 255, 0.15)';
    }
  }
}
</script>

{% schema %}
{
  "name": "Main Login Section",
  "settings": []
}
{% endschema %}
