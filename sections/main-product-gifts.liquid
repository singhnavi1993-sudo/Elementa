<!-- CUSTOM STUDIO VIEW: Product Detail & Configurator (Opens when any product card is clicked) -->
<div id="gift-custom-mode-view" class="sticker-mode-view" style="display: none; padding: 20px 0 70px;">
  <div class="container">

    <!-- DYNAMIC INTERACTIVE HERO SECTION (Fullscreen -> Shrunk Left on 10s timer or Scroll) -->
    <style>
      .gift-interactive-hero-container {
        width: 100vw !important;
        max-width: 100vw !important;
        margin-left: calc(50% - 50vw) !important;
        margin-right: calc(50% - 50vw) !important;
        background: linear-gradient(135deg, #B2B4B3 0%, #A2D9F7 100%) !important;
        color: #0f172a;
        position: relative;
        overflow: hidden;
        transition: all 1.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .gift-hero-fullscreen {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        z-index: 99999 !important;
        background: linear-gradient(135deg, #B2B4B3 0%, #A2D9F7 100%) !important;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 0 !important;
      }
      .gift-hero-fullscreen .gift-hero-video-card {
        position: absolute;
        inset: 0;
        width: 100vw !important;
        height: 100vh !important;
        border-radius: 0px !important;
        box-shadow: none !important;
        border: none !important;
        z-index: 10;
        overflow: hidden;
        background-color: #0f172a;
        transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                    height 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                    border-radius 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 1.4s ease;
      }
      .gift-hero-fullscreen .gift-hero-content-card {
        opacity: 0 !important;
        transform: translateX(180px) !important;
        pointer-events: none !important;
        position: absolute;
        right: 5%;
        z-index: 0;
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .gift-hero-split {
        position: relative !important;
        inset: auto !important;
        width: 100vw !important;
        max-width: 100vw !important;
        margin-left: calc(50% - 50vw) !important;
        margin-right: calc(50% - 50vw) !important;
        min-height: 50vh !important;
        height: auto !important;
        z-index: 10 !important;
        background: linear-gradient(135deg, #B2B4B3 0%, #A2D9F7 100%) !important;
        padding: 2rem 4rem !important;
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 3.5rem !important;
        overflow: hidden !important;
