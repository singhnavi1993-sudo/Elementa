<script>
  (function() {
    function cleanStr(s) {
      return (s || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    }

    function autoOpenGiftProductFromUrl() {
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const prodParam = (urlParams.get('product') || urlParams.get('open_product') || '').toLowerCase().trim();
        const idParam = (urlParams.get('id') || '').trim();
        const titleParam = (urlParams.get('title') || urlParams.get('open_title') || '').toLowerCase().trim();

        if (!prodParam && !idParam && !titleParam) return;

        const cards = Array.from(document.querySelectorAll('#gift-catalog-view .inbuilt-product-card'));
        if (cards.length === 0) {
          setTimeout(autoOpenGiftProductFromUrl, 150);
          return;
        }

        const normProd = cleanStr(prodParam);
        const normTitle = cleanStr(titleParam);

        let matchedCard = null;

        // 1. Try matching by ID first
        if (idParam) {
          matchedCard = cards.find(function(c) {
            const cid = c.getAttribute('data-id');
            const mediaOnclick = c.querySelector('.inbuilt-card-media')?.getAttribute('onclick') || '';
            return (cid && cid === idParam) || mediaOnclick.includes("'" + idParam + "'") || mediaOnclick.includes('"' + idParam + '"');
          });
        }

        // 2. Try matching by handle or title
        if (!matchedCard) {
          matchedCard = cards.find(function(c) {
            const cardHandle = cleanStr(c.getAttribute('data-handle'));
            const cardTitle = cleanStr(c.getAttribute('data-title') || c.querySelector('h3')?.textContent);

            if (normProd && cardHandle && (cardHandle === normProd || cardHandle.includes(normProd) || normProd.includes(cardHandle))) return true;
            if (normTitle && cardTitle && (cardTitle === normTitle || cardTitle.includes(normTitle) || normTitle.includes(cardTitle))) return true;
            return false;
          });
        }

        // 3. Fallback title keywords
        if (!matchedCard && normTitle) {
          matchedCard = cards.find(function(c) {
            const cardText = cleanStr(c.textContent);
            return cardText.includes(normTitle) || normTitle.includes(cardText.slice(0, 15));
          });
        }

        if (matchedCard) {
          setTimeout(function() {
            const custBtn = matchedCard.querySelector('.gift-card-customize-btn') || matchedCard.querySelector('.inbuilt-card-media') || matchedCard.querySelector('h3');
            if (custBtn) {
              custBtn.click();
              // Scroll to custom configurator studio smoothly
              setTimeout(function() {
                const studio = document.getElementById('gift-custom-mode-view') || document.getElementById('gift-studio-configurator-section');
                if (studio) {
                  studio.scrollIntoView({ behavior: 'smooth' });
                }
              }, 100);
            }
          }, 120);
        }
      } catch (err) {
        console.warn('Auto-open gift error:', err);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(autoOpenGiftProductFromUrl, 250);
      });
    } else {
      setTimeout(autoOpenGiftProductFromUrl, 250);
    }
  })();
</script>

