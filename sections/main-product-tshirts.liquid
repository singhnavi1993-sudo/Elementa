    display: none !important;
  }
  /* Hide discount slab elements when viewing an in-built t-shirt product */
  body.inbuilt-tshirt-active .tshirt-top-price-card #tshirt-top-mrp-num,
  body.inbuilt-tshirt-active .tshirt-top-price-card #tshirt-top-save-badge,
  body.inbuilt-tshirt-active .elementa-pricing-step,
  body.inbuilt-tshirt-active .elementa-volume-tracker-card,
  body.inbuilt-tshirt-active .elementa-nudge-bar,
  body.inbuilt-tshirt-active #tshirt-upsell-nudge-bar,
  body.inbuilt-tshirt-active #elementa-discount-table-expand {
    display: none !important;
  }
  .product-page-section, 
  main, 
  #custom-mode-view, 
  .shopify-section {
    overflow: visible !important;
    transform: none !important;
    perspective: none !important;
    height: auto !important;
  }
  .product-detail-grid {
    display: flex !important;
    align-items: flex-start !important;
  }
  /* Desktop (>= 992px): Two-column side-by-side with sticky gallery */
  @media (min-width: 992px) {
