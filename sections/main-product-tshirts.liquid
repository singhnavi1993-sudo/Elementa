            <!-- Canvas Control Quick Bar -->
            <div class="canvas-controls-bar" style="position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); z-index: 15; background: rgba(15, 23, 42, 0.88); padding: 8px 18px; border-radius: 999px; display: flex; align-items: center; gap: 8px; backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); font-size: 12px; color: #e2e8f0; white-space: nowrap;">
