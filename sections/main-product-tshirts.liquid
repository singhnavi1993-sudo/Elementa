                        <input type="number" class="elementa-compact-input" id="size-qty-input-M" value="0" min="0" oninput="directInputSizeQty('M', this.value)">
                        <button type="button" class="elementa-compact-btn" onclick="adjustSizeQty('M', 1)">+</button>
                      </div>
                    </div>
                    <!-- L (40) -->
                    <div class="elementa-compact-size-card" id="size-card-L">
                      <span class="elementa-compact-size-label">L (40)</span>
                      <div class="elementa-compact-counter">
                        <button type="button" class="elementa-compact-btn" onclick="adjustSizeQty('L', -1)">−</button>
                        <input type="number" class="elementa-compact-input" id="size-qty-input-L" value="0" min="0" oninput="directInputSizeQty('L', this.value)">
                        <button type="button" class="elementa-compact-btn" onclick="adjustSizeQty('L', 1)">+</button>
                      </div>
                    </div>
                    <!-- XL (42) -->
                    <div class="elementa-compact-size-card" id="size-card-XL">
                      <span class="elementa-compact-size-label">XL (42)</span>
                      <div class="elementa-compact-counter">
                        <button type="button" class="elementa-compact-btn" onclick="adjustSizeQty('XL', -1)">−</button>
                        <input type="number" class="elementa-compact-input" id="size-qty-input-XL" value="0" min="0" oninput="directInputSizeQty('XL', this.value)">
                        <button type="button" class="elementa-compact-btn" onclick="adjustSizeQty('XL', 1)">+</button>
                      </div>
                    </div>
                    <!-- XXL (44) -->
                    <div class="elementa-compact-size-card" id="size-card-XXL">
                      <span class="elementa-compact-size-label">XXL (44)</span>
                      <div class="elementa-compact-counter">
                        <button type="button" class="elementa-compact-btn" onclick="adjustSizeQty('XXL', -1)">−</button>
                        <input type="number" class="elementa-compact-input" id="size-qty-input-XXL" value="0" min="0" oninput="directInputSizeQty('XXL', this.value)">
                        <button type="button" class="elementa-compact-btn" onclick="adjustSizeQty('XXL', 1)">+</button>
                      </div>
                    </div>
                  </div>
                </div>

              </div>

              <!-- SPECIAL INSTRUCTIONS BOX -->
              <div class="elementa-instructions-box">
                <label for="tshirt-special-instructions" class="elementa-instructions-label">
                  <i class="fa-solid fa-pen-nib" style="color: #A8D4B0;"></i> Any special instructions?
                </label>
                <textarea id="tshirt-special-instructions" class="elementa-instructions-textarea" placeholder="For example: Print position, additional text" oninput="updateSpecialInstructions(this.value)"></textarea>
              </div>

            </div>

            <!-- Step 3: UPLOAD YOUR ARTWORK / LOGO IMAGES (UP TO 2 IMAGES) -->
            <div class="config-step">
              <label class="step-label">3. UPLOAD YOUR ARTWORK / LOGOS (UP TO 2 IMAGES): <span style="font-size: 12px; color: var(--primary-teal);">(Renders live on shirt above)</span></label>
              
              <!-- Design Approval Reassurance Banner -->
              <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-circle-check" style="color: var(--primary-teal); font-size: 16px;"></i>
                <span style="font-size: 13px; font-weight: 700; color: #15803d;">We’ll Send Design for Approval After Order is Placed/Confirmed</span>
              </div>
              
              <!-- Number of Logos Selector (1 Image vs 2 Images) -->
              <div style="margin-bottom: 14px; background: #f8fafc; padding: 12px; border-radius: 10px; border: 1px solid #e2e8f0;">
                <label style="font-size: 13px; font-weight: 700; color: var(--dark-main); display: block; margin-bottom: 8px;">
                  <i class="fa-solid fa-images" style="color: var(--primary-teal);"></i> NUMBER OF LOGO IMAGES TO PRINT:
                </label>
                <div style="display: flex; gap: 10px;">
                  <button type="button" class="shape-btn" id="btn-logo-count-1" onclick="setTshirtLogoCount(1, this)" style="flex: 1; text-align: center; justify-content: center; padding: 8px 14px; font-weight: 700; font-size: 13px;">
                    <i class="fa-solid fa-image"></i> Image (Front 4" X 4")
                  </button>
                  <button type="button" class="shape-btn" id="btn-logo-count-2" onclick="setTshirtLogoCount(2, this)" style="flex: 1; text-align: center; justify-content: center; padding: 8px 14px; font-weight: 700; font-size: 13px;">
                    <i class="fa-solid fa-images"></i> Images (Back 10" X 10")
                  </button>
                </div>
                <!-- Round Neck Front Print Area Size Selector (4" x 4" vs 10" x 10") -->
                <div id="roundneck-front-box-selector" style="display: none; margin-top: 10px; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 10px 12px; border-radius: 10px;">
                  <span style="font-size: 11px; font-weight: 800; color: #166534; display: block; margin-bottom: 6px;"><i class="fa-solid fa-ruler"></i> Choose Front Print Size:</span>
                  <div style="display: flex; gap: 8px;">
                    <button type="button" id="btn-rn-box-4x4" class="shape-btn active" onclick="setRoundNeckFrontBoxMode('4x4', this)" style="flex: 1; padding: 6px; font-size: 11px; text-align: center;">Front (4" × 4")</button>
                    <button type="button" id="btn-rn-box-12x12" class="shape-btn" onclick="setRoundNeckFrontBoxMode('10x10', this)" style="flex: 1; padding: 6px; font-size: 11px; text-align: center;">Front (10" × 10")</button>
                  </div>
                </div>
              </div>

              <!-- Dual Upload Dropzones Grid -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; margin-bottom: 15px;">
                <!-- Image 1 Dropzone -->
                <div class="artwork-dropzone" id="tshirt-dropzone-1" style="background: #ffffff; border: 2px dashed var(--primary-teal); border-radius: 12px; padding: 14px; text-align: center; cursor: pointer; display: none;" onclick="document.getElementById('tshirt-file-input-1').click()">
                  <div style="font-size: 11px; font-weight: 800; color: #00b894; margin-bottom: 4px; text-transform: uppercase;">
                    <i class="fa-solid fa-circle-1"></i> Front Logo Image 1
                  </div>
                  <i class="fa-solid fa-cloud-arrow-up fa-xl" style="color: var(--primary-teal); margin-bottom: 6px;"></i>
                  <p style="margin: 0; font-size: 13px; font-weight: 700; color: #1e293b;">Click to Upload Image 1</p>
                  <span style="font-size: 11px; color: var(--text-muted); display: block; margin-top: 2px;">PNG, SVG, AI, PSD, JPG</span>
                  <input type="file" id="tshirt-file-input-1" accept="image/*,.ai,.psd,.pdf,.svg" style="display: none;" onchange="handleTshirtFileUploadNum(1, this)">
                </div>

                <!-- Image 2 Dropzone -->
                <div class="artwork-dropzone" id="tshirt-dropzone-2" style="background: #ffffff; border: 2px dashed #0284c7; border-radius: 12px; padding: 14px; text-align: center; cursor: pointer; display: none;" onclick="if(!tshirtState.hasBackPrint){ showToast('🔒 Please turn ON \'Add Back Print (+₹100/pc)\' switch above first!'); document.getElementById('tshirt-back-print-toggle')?.scrollIntoView({behavior:'smooth', block:'center'}); } else { document.getElementById('tshirt-file-input-2').click(); }">
                  <div style="font-size: 11px; font-weight: 800; color: #0284c7; margin-bottom: 4px; text-transform: uppercase;">
                    <i class="fa-solid fa-circle-2"></i> Back Logo Image 2
                  </div>
                  <i class="fa-solid fa-cloud-arrow-up fa-xl" style="color: #0284c7; margin-bottom: 6px;"></i>
                  <p style="margin: 0; font-size: 13px; font-weight: 700; color: #1e293b;">Click to Upload Image 2</p>
                  <span style="font-size: 11px; color: var(--text-muted); display: block; margin-top: 2px;">PNG, SVG, AI, PSD, JPG</span>
                  <input type="file" id="tshirt-file-input-2" accept="image/*,.ai,.psd,.pdf,.svg" style="display: none;" onchange="handleTshirtFileUploadNum(2, this)">
                </div>
              </div>

              <!-- Uploaded Artworks Card & Fine-Tuning Sliders -->
              <div class="uploaded-artwork-card" id="tshirt-uploaded-artwork-card" style="display: none; margin-top: 15px; background: #f0fdf4; border: 2px dashed var(--primary-teal); border-radius: var(--radius-sm); padding: 16px;">
                <!-- Image 1 File Info Row -->
                <div id="artwork-info-row-1" style="display: none; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; padding-bottom: 10px; border-bottom: 1px solid #dcfce7;">
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 46px; height: 46px; border-radius: 8px; border: 1px solid var(--border-color); background: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 4px; box-shadow: var(--shadow-sm);">
                      <img id="tshirt-artwork-thumb-preview-1" src="" alt="Thumb 1" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                    </div>
                    <div>
                      <strong id="tshirt-artwork-file-name-1" style="font-size: 13px; color: var(--dark-main); display: block;">Image 1: my-logo.png</strong>
