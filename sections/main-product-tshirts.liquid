                    </div>
                  </div>
                  <button type="button" onclick="removeTshirtUploadedArtworkNum(1)" style="background: #fee2e2; color: #ef4444; border: none; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 11px; cursor: pointer;">
                    <i class="fa-solid fa-trash-can"></i> Remove 1
                  </button>
                </div>

                <!-- Image 2 File Info Row -->
                <div id="artwork-info-row-2" style="display: none; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; margin-top: 10px; pt-2; border-top: 1px dashed #7dd3fc;">
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 46px; height: 46px; border-radius: 8px; border: 1px solid var(--border-color); background: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 4px; box-shadow: var(--shadow-sm);">
                      <img id="tshirt-artwork-thumb-preview-2" src="" alt="Thumb 2" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                    </div>
                    <div>
                      <strong id="tshirt-artwork-file-name-2" style="font-size: 13px; color: var(--dark-main); display: block;">Image 2: back-logo.png</strong>
                      <span style="font-size: 11px; color: #0284c7; font-weight: 700;"><i class="fa-solid fa-circle-check"></i> Image 2 live on shirt</span>
                    </div>
                  </div>
                  <button type="button" onclick="removeTshirtUploadedArtworkNum(2)" style="background: #fee2e2; color: #ef4444; border: none; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 11px; cursor: pointer;">
                    <i class="fa-solid fa-trash-can"></i> Remove 2
                  </button>
                </div>

                <!-- Active Logo Edit Selector -->
                <div id="active-logo-edit-tab-container" style="margin-top: 14px; background: #e0f2fe; padding: 10px 12px; border-radius: 8px; border: 1px solid #7dd3fc; display: none;">
                  <label style="font-size: 12px; font-weight: 800; color: #0369a1; display: block; margin-bottom: 6px;">
                    <i class="fa-solid fa-sliders"></i> CHOOSE LOGO TO ADJUST SIZE & POSITION:
                  </label>
                  <div style="display: flex; gap: 8px;">
                    <button type="button" class="qty-chip-btn active" id="btn-edit-logo-1" onclick="setActiveEditLogo(1, this)" style="flex: 1; text-align: center; justify-content: center; font-weight: 800; padding: 6px; font-size: 12px;">
                      🟢 Image 1 (Front)
                    </button>
                    <button type="button" class="qty-chip-btn" id="btn-edit-logo-2" onclick="setActiveEditLogo(2, this)" style="flex: 1; text-align: center; justify-content: center; font-weight: 800; padding: 6px; font-size: 12px;">
                      🔵 Image 2 (Back 10" × 10")
                    </button>
                  </div>
                </div>

                <!-- Logo Size Slider -->
                <div style="margin-top: 14px; display: flex; flex-direction: column; gap: 10px;">
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 12px; font-weight: 700; color: var(--dark-main); width: 85px;"><i class="fa-solid fa-magnifying-glass-plus" style="color: var(--primary-teal);"></i> Logo Size:</span>
                    <input type="range" id="tshirt-artwork-scale-slider" min="20" max="100" value="80" oninput="updateTshirtArtworkScale(this.value)" style="flex: 1; accent-color: var(--primary-teal);">
                    <span id="tshirt-artwork-scale-percent" style="font-size: 12px; font-weight: 800; color: var(--primary-teal); width: 45px; text-align: right;">80%</span>
                  </div>
                </div>
              </div>
            </div>



            <!-- Step 4: Authorization & Approval (Shown after adding logo in front or back) -->
            <div class="config-step" id="tshirt-auth-step-box" style="display: none; margin-top: 18px; background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 14px 16px;">
              <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer; user-select: none; font-size: 13px; font-weight: 700; color: #1e293b; line-height: 1.5;">
                <input type="checkbox" id="tshirt-auth-checkbox" onchange="toggleTshirtAddToCartState()" style="width: 20px; height: 20px; min-width: 20px; min-height: 20px; accent-color: #143d1c; margin-top: 1px; cursor: pointer;">
                <span>I have authorization to use the design, I have reviewed and approved it.</span>
              </label>
            </div>

            <div style="margin-top: 25px;">
              <button class="btn-primary btn-add-sticker-cart" id="btn-add-tshirt-cart" onclick="addTshirtToCart()" disabled="disabled" style="width: 100%; margin-top: 0; transition: all 0.3s ease; opacity: 0.45; cursor: not-allowed; pointer-events: none; background: #94a3b8; filter: grayscale(0.6);">
                <i class="fa-solid fa-cart-shopping"></i> Add Custom T-Shirt to Cart • ₹1,445.00
              </button>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Size Chart Guide Banner Section -->
  <section class="size-chart-banner-section reveal-on-scroll" style="background: #ffffff; padding: 60px 0 20px; border-top: 1px solid #e2e8f0;">
    <div class="container" style="text-align: center;">
      <div style="max-width: 1240px; margin: 0 auto; background: #ffffff; border-radius: 24px; padding: 35px 40px; box-shadow: 0 12px 35px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;">
        <span style="background: #f1f5f9; color: #0f172a; padding: 6px 18px; border-radius: 999px; font-weight: 800; font-size: 13px; letter-spacing: 0.5px; text-transform: uppercase; display: inline-block; margin-bottom: 16px;">Size & Fit Guide</span>
        <h2 style="color: #0f172a; font-size: 32px; font-weight: 900; margin-bottom: 24px;">T-Shirt Size Chart</h2>
        <img id="size-chart-banner-img" src="{{ 'size-chart-polo.png' | asset_url }}" alt="T-Shirt Size Chart Guide" style="width: 100%; height: auto; max-width: 720px; display: block; margin: 0 auto; border-radius: 14px; box-shadow: 0 8px 25px rgba(0,0,0,0.06);">
      </div>
    </div>
  </section>

  <!-- Order Process Timeline Banner Section (Customizable via Shopify Theme Editor Settings) -->
  {% if section.settings.show_order_process_timeline != false %}
  <section class="order-process-banner-section reveal-on-scroll" style="background: {{ section.settings.order_process_bg_color | default: '#F5AD72' }}; padding: {{ section.settings.order_process_padding_v | default: 75 }}px 0; box-shadow: inset 0 2px 10px rgba(0,0,0,0.05);">
    <div class="container" style="text-align: center;">
      <div style="max-width: {{ section.settings.order_process_card_max_width | default: 840 }}px; margin: 0 auto; background: {{ section.settings.order_process_card_bg_color | default: '#ffffff' }}; border-radius: 24px; padding: {{ section.settings.order_process_card_padding_v | default: 50 }}px {{ section.settings.order_process_card_padding_h | default: 35 }}px; box-shadow: 0 14px 40px rgba(0,0,0,0.14); border: 1px solid rgba(255,255,255,0.4);">
        {% if section.settings.order_process_image != blank %}
          <img src="{{ section.settings.order_process_image | image_url: width: 1200 }}" alt="{{ section.settings.order_process_image.alt | default: 'Order Process & Delivery Steps' }}" style="width: 100%; height: auto; max-width: {{ section.settings.order_process_image_max_width | default: 760 }}px; display: block; margin: 0 auto; border-radius: 14px;">
        {% else %}
          <img src="{{ 'order-process-timeline.jpg' | asset_url }}" alt="Order Process & Delivery Steps" style="width: 100%; height: auto; max-width: {{ section.settings.order_process_image_max_width | default: 760 }}px; display: block; margin: 0 auto; border-radius: 14px;">
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Customer Reviews Section -->
  {% render 'judgeme-review-widget', product: product %}
</div>
<style>
