                <!-- Logo #1 Container (Fixed Pocket / Front Print Box) -->
                <div class="tshirt-draggable-logo-container" id="tshirt-draggable-logo-container" onclick="setActiveEditLogo(1, event)" style="position: absolute; top: {% if is_oversized %}47%{% elsif is_round %}35.5%{% else %}41.3%{% endif %}; left: {% if is_oversized %}29.35%{% elsif is_round %}36.3%{% else %}37.7%{% endif %}; transform: translate(-50%, -50%); cursor: pointer; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; user-select: none; touch-action: none;">
                  <!-- Pocket / Front Print Area Badge -->
                  <span class="tshirt-drag-badge" id="tshirt-front-print-badge" style="position: absolute; top: -22px; left: 50%; transform: translateX(-50%); font-size: 10px; font-weight: 800; background: #00b894; color: #ffffff; padding: 2px 8px; border-radius: 999px; white-space: nowrap; pointer-events: none; opacity: 1 !important; transition: opacity 0.2s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.3); z-index: 20;">
                    <i class="fa-solid fa-ruler-combined"></i> {% if is_oversized %}12" × 12" Front Print Area{% elsif is_round %}10" × 10" Front Print Area{% else %}4" × 4" Front Print Area{% endif %}
                  </span>
                  <!-- Transparent Print Box Container with Border & Strict Overflow Clipping -->
                  <div class="tshirt-print-box-4x4" id="tshirt-print-box-4x4" style="width: {% if is_oversized %}144px{% elsif is_round %}72px{% else %}49px{% endif %}; height: {% if is_oversized %}175px{% elsif is_round %}72px{% else %}49px{% endif %}; min-width: {% if is_oversized %}144px{% elsif is_round %}72px{% else %}49px{% endif %}; min-height: {% if is_oversized %}175px{% elsif is_round %}72px{% else %}49px{% endif %}; border: 2px dashed #00b894; background: transparent; border-radius: 5px; overflow: hidden !important; display: flex; align-items: center; justify-content: center; position: relative; box-shadow: none;">
                    <!-- Crisp Logo Image (Clipped at border when scaled up) -->
                    <img id="tshirt-canvas-logo-img" src="" alt="Uploaded Logo 1" style="display: none; object-fit: contain; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25)); image-rendering: -webkit-optimize-contrast; max-width: none; max-height: none;">
                  </div>
                </div>

                <!-- Logo #2 Container -->
                <div class="tshirt-draggable-logo-container" id="tshirt-draggable-logo-container-2" onclick="setActiveEditLogo(2, event)" style="position: absolute; top: {% if is_oversized %}47%{% elsif is_round %}45%{% else %}38%{% endif %}; left: {% if is_oversized %}71.48%{% elsif is_round %}72.5%{% else %}72%{% endif %}; transform: translate(-50%, -50%); cursor: grab; z-index: 11; display: none; flex-direction: column; align-items: center; justify-content: center; user-select: none; padding: 4px; touch-action: none; box-sizing: border-box !important;">
                  <span class="tshirt-drag-badge" id="tshirt-back-print-badge" style="position: absolute; top: -20px; left: 50%; transform: translateX(-50%); font-size: 10px; font-weight: 800; background: #0284c7; color: #ffffff; padding: 2px 8px; border-radius: 999px; white-space: nowrap; pointer-events: none; opacity: 1 !important; transition: opacity 0.2s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.3);">
                    <i class="fa-solid fa-ruler-combined"></i> {% if is_oversized %}12" × 12" Back Print Area{% else %}10" × 10" Back Print Area{% endif %}
                  </span>
                  <div class="tshirt-print-box-4x4" id="tshirt-print-box-12x12" style="width: {% if is_oversized %}140px{% elsif is_round %}210px{% else %}85px{% endif %}; height: {% if is_oversized %}173px{% elsif is_round %}210px{% else %}85px{% endif %}; min-width: {% if is_oversized %}140px{% elsif is_round %}210px{% else %}85px{% endif %}; min-height: {% if is_oversized %}173px{% elsif is_round %}210px{% else %}85px{% endif %}; border: 2px dashed #0284c7; background: transparent; border-radius: 5px; overflow: hidden !important; display: flex; align-items: center; justify-content: center; position: relative; box-shadow: none; box-sizing: border-box !important;">
                    <img id="tshirt-canvas-logo-img-2" src="" alt="Uploaded Logo 2" style="display: none; max-width: 100% !important; max-height: 100% !important; object-fit: contain !important; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3)); image-rendering: -webkit-optimize-contrast; pointer-events: auto; overflow: hidden !important;">
                  </div>
                </div>

                <!-- Standalone Draggable Custom Text Container -->
                <div class="tshirt-draggable-text-container" id="tshirt-draggable-text-container" onclick="setActiveEditLogo('text', event)" style="position: absolute; top: 62%; left: 35%; transform: translate(-50%, -50%); cursor: grab; z-index: 12; display: none; flex-direction: column; align-items: center; justify-content: center; user-select: none; padding: 4px; touch-action: none;">
                  <span class="tshirt-drag-badge" style="position: absolute; top: -20px; left: 50%; transform: translateX(-50%); font-size: 10px; font-weight: 800; background: #e11d48; color: #ffffff; padding: 2px 8px; border-radius: 999px; white-space: nowrap; pointer-events: none; opacity: 1 !important; transition: opacity 0.2s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.3);">
                    <i class="fa-solid fa-font"></i> Drag Custom Text
                  </span>
                  <div id="tshirt-canvas-text-display" class="tshirt-canvas-text-display" style="font-size: 16px; font-weight: 800; color: #ffffff; text-shadow: 0 2px 6px rgba(0,0,0,0.9); text-align: center; white-space: pre-wrap; font-family: 'Outfit', sans-serif; cursor: grab;"></div>
