    <div class="container">
      <div class="sticker-mode-bar tshirt-fit-selector-bar" style="display: inline-flex; background: #ffffff; padding: 6px; border-radius: 999px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e2e8f0; gap: 6px; flex-wrap: wrap; justify-content: center;">
        <button type="button" class="mode-tab-btn tshirt-fit-sub-btn {% if is_oversized == false and is_round == false %}active{% endif %}" onclick="selectTshirtFit('Polo T Shirts', this)" style="padding: 10px 26px; border-radius: 999px; font-weight: 800; font-size: 13px; border: none; cursor: pointer; transition: all 0.3s ease; background: {% if is_oversized == false and is_round == false %}#A8D4B0{% else %}transparent{% endif %}; color: {% if is_oversized == false and is_round == false %}#143d1c{% else %}var(--dark-main){% endif %};">
          <i class="fa-solid fa-shirt"></i> Polo T-Shirts
        </button>
        <button type="button" class="mode-tab-btn tshirt-fit-sub-btn {% if is_oversized %}active{% endif %}" onclick="selectTshirtFit('Oversized T-Shirts', this)" style="padding: 10px 26px; border-radius: 999px; font-weight: 800; font-size: 13px; border: none; cursor: pointer; transition: all 0.3s ease; background: {% if is_oversized %}#A8D4B0{% else %}transparent{% endif %}; color: {% if is_oversized %}#143d1c{% else %}var(--dark-main){% endif %};">
          <i class="fa-solid fa-vest"></i> Oversized T-Shirts
        </button>
        <button type="button" class="mode-tab-btn tshirt-fit-sub-btn {% if is_round %}active{% endif %}" onclick="selectTshirtFit('Rounded Neck', this)" style="padding: 10px 26px; border-radius: 999px; font-weight: 800; font-size: 13px; border: none; cursor: pointer; transition: all 0.3s ease; background: {% if is_round %}#A8D4B0{% else %}transparent{% endif %}; color: {% if is_round %}#143d1c{% else %}var(--dark-main){% endif %};">
          <i class="fa-solid fa-shirt"></i> Round Neck T-Shirts
        </button>
      </div>
    </div>
  </div>

  <section class="product-page-section" style="padding: 20px 0 80px; background: #ffffff;">
    <div class="container" style="max-width: 1720px; width: 100%;">
