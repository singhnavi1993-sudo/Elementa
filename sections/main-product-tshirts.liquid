    }
    .product-gallery-col .main-image-container,
    .product-gallery-col #tshirt-lifestyle-view,
    .product-gallery-col #tshirt-canvas-view,
    .product-gallery-col .tshirt-photo-canvas-container,
    .product-gallery-col #tshirt-canvas-stage-wrapper {
      min-height: 380px !important;
