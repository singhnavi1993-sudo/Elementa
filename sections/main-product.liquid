{% comment %}
  Elementa Theme - Master Individual Product Template
  Dynamically adapts to T-Shirts, UV DTF Transfer Sheets (Tumblers & Mugs), Gifts, and Caps.
{% endcomment %}

{% assign p_type = product.type | downcase %}
{% assign p_tags = product.tags | join: ',' | downcase %}
{% assign p_title = product.title | downcase %}
{% assign p_handle = product.handle | downcase %}

{% assign is_tshirt = false %}
{% assign is_sticker = false %}
{% assign is_gift = false %}
{% assign is_cap = false %}

{% if p_tags contains 'gift' or p_tags contains 'gift-set' or p_type contains 'gift' or p_title contains 'gift' or p_title contains 'card holder' %}
  {% assign is_gift = true %}
{% elsif p_tags contains 'cap' or p_type contains 'cap' or p_title contains 'cap' %}
  {% assign is_cap = true %}
{% elsif p_tags contains 'tumbler' or p_tags contains 'mug' or p_tags contains 'sticker' or p_tags contains 'uv-dtf' or p_title contains 'transfer' or p_title contains 'trasfer' or p_type contains 'transfer' or p_type contains 'sticker' or p_title contains 'sheet' %}
  {% assign is_sticker = true %}
{% elsif p_tags contains 't-shirt' or p_tags contains 'shirt' or p_tags contains 'oversized' or p_tags contains 'polo' or p_tags contains 'hoodie' or p_type contains 'shirt' or p_type contains 'apparel' or p_title contains 'tee' or p_title contains 'shirt' or p_title contains 'hoodie' or p_title contains 'polo' or p_title contains 'oversize' %}
  {% assign is_tshirt = true %}
{% else %}
  {% if p_title contains 'tumbler' or p_title contains 'mug' %}
    {% assign is_sticker = true %}
  {% else %}
    {% assign is_tshirt = true %}
  {% endif %}
{% endif %}

{% comment %} Instant Redirect to In-Built Product Experience with Auto-Opening Pop-Up/Studio {% endcomment %}
<script>
  (function() {
    {% if is_sticker %}
      {% if p_title contains 'mug' or p_tags contains 'mug' %}
        window.location.replace('/pages/stickers?cat=mug&product={{ product.handle }}&title={{ product.title | url_encode }}');
      {% else %}
        window.location.replace('/pages/stickers?cat=tumbler&product={{ product.handle }}&title={{ product.title | url_encode }}');
      {% endif %}
    {% elsif is_gift %}
      window.location.replace('/pages/gifts?product={{ product.handle }}&id={{ product.id }}&title={{ product.title | url_encode }}');
    {% elsif is_tshirt %}
      window.location.replace('/pages/t-shirts?product={{ product.handle }}&title={{ product.title | url_encode }}');
    {% endif %}
  })();
</script>

{% comment %} Calculate Clean Display Price {% endcomment %}
{% assign display_price = product.price %}
{% if display_price < 3000 or display_price == blank %}
  {% if is_tshirt %}
    {% if p_title contains "hoodie" or p_title contains "sweatshirt" %}
      {% assign display_price = 129900 %}
    {% elsif p_title contains "oversiz" %}
      {% assign display_price = 79900 %}
    {% elsif p_title contains "polo" %}
      {% assign display_price = 62500 %}
    {% elsif p_title contains "round" %}
      {% assign display_price = 59900 %}
    {% else %}
      {% assign display_price = 79900 %}
    {% endif %}
  {% elsif is_sticker %}
    {% assign display_price = 15000 %}
  {% elsif is_gift %}
    {% if display_price < 3000 %}{% assign display_price = 24900 %}{% endif %}
  {% elsif is_cap %}
    {% assign display_price = 25000 %}
  {% endif %}
{% endif %}

{% assign clean_title = product.title | replace: 'Trasfer', 'Transfer' | replace: 'trasfer', 'transfer' %}

<section class="master-product-section" style="padding: 40px 0 80px; background: #ffffff; min-height: 80vh;">
  <div class="container" style="max-width: 1240px; margin: 0 auto; padding: 0 20px;">
    
    <!-- Top Breadcrumbs & Back Navigation -->
    <div class="prod-breadcrumb-bar" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; flex-wrap: wrap; gap: 14px; border-bottom: 1px solid #f1f5f9; padding-bottom: 16px;">
      {% if is_tshirt %}
        <a href="/pages/t-shirts" class="prod-back-btn" style="background: #f1f5f9; color: #0f172a; border: 1px solid #cbd5e1; padding: 9px 18px; border-radius: 12px; font-weight: 800; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
          <i class="fa-solid fa-arrow-left"></i> Back to T-Shirts
        </a>
        <nav style="font-size: 13.5px; color: #64748b;">
          <a href="/" style="color: #64748b; text-decoration: none;">Home</a> / 
          <a href="/pages/t-shirts" style="color: #64748b; text-decoration: none;">T-Shirts</a> / 
          <strong style="color: #0f172a;">{{ clean_title }}</strong>
        </nav>
      {% elsif is_sticker %}
        <a href="/pages/stickers" class="prod-back-btn" style="background: #f1f5f9; color: #0f172a; border: 1px solid #cbd5e1; padding: 9px 18px; border-radius: 12px; font-weight: 800; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
          <i class="fa-solid fa-arrow-left"></i> Back to Stickers & Drinkware
        </a>
        <nav style="font-size: 13.5px; color: #64748b;">
          <a href="/" style="color: #64748b; text-decoration: none;">Home</a> / 
          <a href="/pages/stickers" style="color: #64748b; text-decoration: none;">UV DTF Sheets</a> / 
          <strong style="color: #0f172a;">{{ clean_title }}</strong>
        </nav>
      {% elsif is_gift %}
        <a href="/pages/gifts" class="prod-back-btn" style="background: #f1f5f9; color: #0f172a; border: 1px solid #cbd5e1; padding: 9px 18px; border-radius: 12px; font-weight: 800; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
          <i class="fa-solid fa-arrow-left"></i> Back to Gifts
        </a>
        <nav style="font-size: 13.5px; color: #64748b;">
          <a href="/" style="color: #64748b; text-decoration: none;">Home</a> / 
          <a href="/pages/gifts" style="color: #64748b; text-decoration: none;">Personalised Gifts</a> / 
          <strong style="color: #0f172a;">{{ clean_title }}</strong>
        </nav>
      {% else %}
        <a href="/" class="prod-back-btn" style="background: #f1f5f9; color: #0f172a; border: 1px solid #cbd5e1; padding: 9px 18px; border-radius: 12px; font-weight: 800; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
          <i class="fa-solid fa-arrow-left"></i> Back to Home
        </a>
        <nav style="font-size: 13.5px; color: #64748b;">
          <a href="/" style="color: #64748b; text-decoration: none;">Home</a> / 
          <strong style="color: #0f172a;">{{ clean_title }}</strong>
        </nav>
      {% endif %}
    </div>

    <!-- Master 2-Column Product Grid -->
    <div class="master-prod-layout" style="display: flex; gap: 45px; flex-wrap: wrap; align-items: flex-start;">
      
      <!-- Left Column: Gallery / Images -->
      <div class="prod-gallery-wrapper" style="flex: 1 1 480px; min-width: 0; position: sticky; top: 90px;">
        <div class="prod-main-image-card" style="background: #fafbfc; border-radius: 24px; padding: 30px; border: 1.5px solid #e2e8f0; text-align: center; box-shadow: 0 10px 30px rgba(15,23,42,0.04); position: relative; overflow: hidden;">
          {% if is_tshirt %}
            <span style="position: absolute; top: 16px; left: 16px; background: #A8D4B0; color: #17401F; font-size: 11px; font-weight: 800; padding: 5px 14px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.6px; z-index: 2;">100% Cotton Bio-Washed</span>
          {% elsif is_sticker %}
            <span style="position: absolute; top: 16px; left: 16px; background: #F5AD72; color: #5E3106; font-size: 11px; font-weight: 800; padding: 5px 14px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.6px; z-index: 2;">Waterproof & Dishwasher Safe</span>
          {% elsif is_gift %}
            <span style="position: absolute; top: 16px; left: 16px; background: #A2D9F7; color: #073F61; font-size: 11px; font-weight: 800; padding: 5px 14px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.6px; z-index: 2;">Luxury Executive Gift</span>
          {% endif %}
          
          <img id="master-prod-main-img" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ clean_title | escape }}" style="width: 100%; max-height: 500px; object-fit: contain; border-radius: 14px; display: block; margin: 0 auto; transition: transform 0.3s ease;">
        </div>

        <!-- Thumbnails Gallery Row -->
        {% if product.images.size > 1 or is_sticker %}
          <div class="prod-thumbnails-row" style="display: flex; gap: 12px; margin-top: 18px; justify-content: center; flex-wrap: wrap;">
            {% for img in product.images %}
              <div onclick="selectProductGalleryImg('{{ img | image_url: width: 1000 }}', this)" class="prod-thumb-item {% if forloop.first %}active{% endif %}" style="width: 72px; height: 72px; border-radius: 12px; border: 2px solid {% if forloop.first %}#0f172a{% else %}#e2e8f0{% endif %}; overflow: hidden; cursor: pointer; padding: 4px; background: #ffffff; transition: all 0.2s ease;">
                <img src="{{ img | image_url: width: 200 }}" alt="{{ clean_title | escape }}" style="width: 100%; height: 100%; object-fit: contain;">
              </div>
            {% endfor %}
            {% if is_sticker %}
              {% if p_title contains 'tumbler' or p_tags contains 'tumbler' %}
                <div onclick="selectProductGalleryImg('{{ 'tumbler-sizing-guide.png' | asset_url }}', this)" class="prod-thumb-item" style="width: 72px; height: 72px; border-radius: 12px; border: 2px solid #e2e8f0; overflow: hidden; cursor: pointer; padding: 4px; background: #ffffff; transition: all 0.2s ease;">
                  <img src="{{ 'tumbler-sizing-guide.png' | asset_url }}" alt="Sizing Guide" style="width: 100%; height: 100%; object-fit: contain;">
                </div>
              {% elsif p_title contains 'mug' or p_tags contains 'mug' %}
                <div onclick="selectProductGalleryImg('{{ 'mug-sizing-guide.png' | asset_url }}', this)" class="prod-thumb-item" style="width: 72px; height: 72px; border-radius: 12px; border: 2px solid #e2e8f0; overflow: hidden; cursor: pointer; padding: 4px; background: #ffffff; transition: all 0.2s ease;">
                  <img src="{{ 'mug-sizing-guide.png' | asset_url }}" alt="Sizing Guide" style="width: 100%; height: 100%; object-fit: contain;">
                </div>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Right Column: Product Info, Options & Add to Cart -->
      <div class="prod-details-col" style="flex: 1 1 500px; min-width: 0; display: flex; flex-direction: column; gap: 22px;">
        
        <!-- Header Info -->
        <div>
          {% if is_tshirt %}
            <span style="background: rgba(168,212,176,0.3); color: #17401F; padding: 6px 16px; border-radius: 999px; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; display: inline-block; margin-bottom: 12px; border: 1px solid rgba(168,212,176,0.6);">
              {% if p_title contains 'oversiz' %}Oversized T-Shirt{% elsif p_title contains 'polo' %}Polo T-Shirt{% elsif p_title contains 'round' %}Round Neck Tee{% else %}Premium T-Shirt{% endif %}
            </span>
          {% elsif is_sticker %}
            <span style="background: rgba(245,173,114,0.3); color: #5E3106; padding: 6px 16px; border-radius: 999px; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; display: inline-block; margin-bottom: 12px; border: 1px solid rgba(245,173,114,0.6);">
              {% if p_title contains 'tumbler' %}UV DTF Tumbler Wrap{% elsif p_title contains 'mug' %}UV DTF Mug Transfer{% else %}UV DTF Transfer Sheet{% endif %}
            </span>
          {% elsif is_gift %}
            <span style="background: rgba(162,217,247,0.3); color: #073F61; padding: 6px 16px; border-radius: 999px; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; display: inline-block; margin-bottom: 12px; border: 1px solid rgba(162,217,247,0.6);">
              Executive Corporate & Personal Gift
            </span>
          {% else %}
            <span style="background: #f1f5f9; color: #334155; padding: 6px 16px; border-radius: 999px; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; display: inline-block; margin-bottom: 12px;">
              Elementa Custom Merch
            </span>
          {% endif %}

          <h1 style="font-size: 32px; font-weight: 900; color: #0f172a; margin: 0 0 10px; line-height: 1.25; letter-spacing: -0.4px;">{{ clean_title }}</h1>
          
          <div style="display: flex; align-items: center; gap: 10px; margin-top: 4px;">
            <div style="color: #f59e0b; font-size: 15px;">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <span style="font-size: 13.5px; color: #64748b; font-weight: 700;">(4.9 ★ • 28 Verified Reviews)</span>
          </div>
        </div>

        <!-- Price Banner -->
        <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 18px 24px; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: baseline; gap: 12px;">
            <strong id="master-prod-price-display" style="font-size: 32px; font-weight: 900; color: #0f172a;">{{ display_price | money }}</strong>
            {% unless is_tshirt %}
              <span style="font-size: 16px; color: #94a3b8; text-decoration: line-through; font-weight: 600;">
                {% if is_sticker %}₹299.00{% else %}₹1,499.00{% endif %}
              </span>
            {% endunless %}
          </div>
          {% unless is_tshirt %}
            <span style="background: #dcfce7; color: #15803d; font-size: 12.5px; font-weight: 800; padding: 4px 12px; border-radius: 999px;">
              {% if is_sticker %}SAVE 50%{% else %}BEST VALUE{% endif %}
            </span>
          {% endunless %}
        </div>

        {% unless is_tshirt %}
          <!-- Bulk Discount Badge Tagline -->
          <div style="background: #fff7ed; border: 1px solid #fed7aa; border-radius: 12px; padding: 12px 18px; display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-tag" style="color: #ea580c; font-size: 16px;"></i>
            <span style="font-size: 13.5px; color: #9a3412; font-weight: 700;">
              {% if is_sticker %}
                Bulk Savings: 5+ sheets at ₹135 each • 10+ sheets at ₹120 each
              {% else %}
                Corporate Bulk Discount: Contact us for exclusive discounts on 10+ units
              {% endif %}
            </span>
          </div>
        {% endunless %}

        {% if product.description != blank %}
          <div class="prod-description-box" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 14px 18px; font-size: 14px; color: #475569; line-height: 1.6;">
            {{ product.description }}
          </div>
        {% endif %}

        <!-- TYPE-SPECIFIC CONTROLS -->

        <!-- CASE 1: T-SHIRT SIZE SELECTOR -->
        {% if is_tshirt %}
          <div class="prod-size-section" style="border-top: 1px dashed #e2e8f0; padding-top: 18px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <label style="font-size: 13.5px; font-weight: 900; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px;">
                SELECT SIZE: <span id="master-selected-size-label" style="color: #166534; font-weight: 900;">M</span>
              </label>
              <button type="button" onclick="openSizeChartModal()" style="background: none; border: none; color: #0284c7; font-weight: 800; font-size: 13px; cursor: pointer; text-decoration: underline; display: inline-flex; align-items: center; gap: 4px;">
                <i class="fa-solid fa-ruler-horizontal"></i> Size Chart
              </button>
            </div>

            {% assign has_size_option = false %}
            {% for opt in product.options_with_values %}
              {% assign opt_name = opt.name | downcase %}
              {% if opt_name contains 'size' %}
                {% assign has_size_option = true %}
                {% assign size_values = opt.values %}
              {% endif %}
            {% endfor %}

            <div class="prod-size-chips" style="display: flex; gap: 10px; flex-wrap: wrap;">
              {% if has_size_option %}
                {% for sz in size_values %}
                  <button type="button" class="prod-size-chip {% if forloop.index == 2 or forloop.first and size_values.size == 1 %}active{% endif %}" onclick="selectMasterProductSize('{{ sz }}', this)" style="padding: 11px 22px; border-radius: 12px; border: 2px solid {% if forloop.index == 2 %}#A8D4B0{% else %}#cbd5e1{% endif %}; background: {% if forloop.index == 2 %}#A8D4B0{% else %}#ffffff{% endif %}; color: {% if forloop.index == 2 %}#143d1c{% else %}#334155{% endif %}; font-weight: 900; font-size: 14.5px; cursor: pointer; transition: all 0.2s ease;">
                    {{ sz }}
                  </button>
                {% endfor %}
              {% else %}
                {% assign default_sizes = 'S,M,L,XL,2XL' | split: ',' %}
                {% for sz in default_sizes %}
                  <button type="button" class="prod-size-chip {% if sz == 'M' %}active{% endif %}" onclick="selectMasterProductSize('{{ sz }}', this)" style="padding: 11px 22px; border-radius: 12px; border: 2px solid {% if sz == 'M' %}#A8D4B0{% else %}#cbd5e1{% endif %}; background: {% if sz == 'M' %}#A8D4B0{% else %}#ffffff{% endif %}; color: {% if sz == 'M' %}#143d1c{% else %}#334155{% endif %}; font-weight: 900; font-size: 14.5px; cursor: pointer; transition: all 0.2s ease;">
                    {{ sz }}
                  </button>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endif %}

        <!-- CASE 2: DRINKWARE ADD-ON FOR TUMBLER / MUG WRAPS -->
        {% if is_sticker %}
          {% assign is_tumbler_sheet = false %}
          {% assign is_mug_sheet = false %}
          {% if p_title contains 'tumbler' or p_tags contains 'tumbler' %}
            {% assign is_tumbler_sheet = true %}
          {% elsif p_title contains 'mug' or p_tags contains 'mug' %}
            {% assign is_mug_sheet = true %}
          {% endif %}

          <div class="prod-addon-section" style="border-top: 1px dashed #e2e8f0; padding-top: 18px;">
            <label style="font-size: 13.5px; font-weight: 900; color: #0f172a; display: block; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;">
              OPTIONAL DRINKWARE ADD-ON:
            </label>

            {% if is_tumbler_sheet %}
              <div onclick="toggleDrinkwareAddon('tumbler')" style="border: 2px solid #e2e8f0; border-radius: 14px; padding: 14px 18px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 14px; background: #fafbfc; transition: all 0.2s ease;" id="addon-drinkware-box">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <input type="checkbox" id="addon-drinkware-checkbox" style="width: 20px; height: 20px; accent-color: #F5AD72; cursor: pointer;">
                  <div>
                    <strong style="font-size: 14.5px; color: #0f172a; display: block;">+ Add 16oz Glass Tumbler with Bamboo Lid & Straw</strong>
                    <span style="font-size: 12.5px; color: #64748b;">Includes high-borosilicate glass can, bamboo lid & clear glass straw</span>
                  </div>
                </div>
                <strong style="font-size: 15px; color: #ea580c; white-space: nowrap;">+ ₹299.00</strong>
              </div>
            {% elsif is_mug_sheet %}
              <div onclick="toggleDrinkwareAddon('mug')" style="border: 2px solid #e2e8f0; border-radius: 14px; padding: 14px 18px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 14px; background: #fafbfc; transition: all 0.2s ease;" id="addon-drinkware-box">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <input type="checkbox" id="addon-drinkware-checkbox" style="width: 20px; height: 20px; accent-color: #F5AD72; cursor: pointer;">
                  <div>
                    <strong style="font-size: 14.5px; color: #0f172a; display: block;">+ Add Premium White Ceramic Mug (11oz)</strong>
                    <span style="font-size: 12.5px; color: #64748b;">Glossy white ceramic coffee mug, microwave & dishwasher safe</span>
                  </div>
                </div>
                <strong style="font-size: 15px; color: #ea580c; white-space: nowrap;">+ ₹149.00</strong>
              </div>
            {% endif %}

            <div id="addon-application-options" style="display: none; margin-top: 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 16px;">
              <span style="font-size: 12px; font-weight: 800; color: #0f172a; display: block; margin-bottom: 6px; text-transform: uppercase;">APPLICATION PREFERENCE:</span>
              <div style="display: flex; gap: 20px;">
                <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 700; color: #334155; cursor: pointer;">
                  <input type="radio" name="addon_app_pref" value="Pre-Applied" checked style="accent-color: #F5AD72;"> Pre-Applied by Us (Ready to use)
                </label>
                <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 700; color: #334155; cursor: pointer;">
                  <input type="radio" name="addon_app_pref" value="DIY Kit" style="accent-color: #F5AD72;"> DIY Kit (Apply it yourself)
                </label>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- CASE 3: CUSTOM LASER ENGRAVING FOR GIFTS -->
        {% if is_gift %}
          <div class="prod-gift-engraving-section" style="border-top: 1px dashed #e2e8f0; padding-top: 18px;">
            <label style="font-size: 13.5px; font-weight: 900; color: #0f172a; display: block; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
              PERSONALISE WITH NAME / LOGO ENGRAVING:
            </label>
            <input type="text" id="master-gift-engraving-input" placeholder="Enter Name or Text to Engrave (e.g. Rahul Sharma)" style="width: 100%; padding: 13px 18px; border: 2px solid #cbd5e1; border-radius: 12px; font-size: 14.5px; font-weight: 700; outline: none; transition: border-color 0.2s ease;">
            <span style="font-size: 12px; color: #64748b; margin-top: 6px; display: block;">Laser engraving is complimentary on all executive gift sets.</span>
          </div>
        {% endif %}

        <!-- QUANTITY SELECTOR -->
        <div style="border-top: 1px dashed #e2e8f0; padding-top: 18px;">
          <label style="font-size: 13.5px; font-weight: 900; color: #0f172a; display: block; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;">QUANTITY:</label>
          <div style="display: inline-flex; align-items: center; border: 2px solid #0f172a; border-radius: 12px; overflow: hidden; background: #ffffff;">
            <button type="button" onclick="changeMasterProductQty(-1)" style="border: none; background: #f1f5f9; width: 44px; height: 44px; font-weight: 900; font-size: 20px; cursor: pointer; color: #0f172a;">-</button>
            <input type="number" id="master-prod-qty-input" value="1" min="1" max="100" style="width: 65px; border: none; text-align: center; font-weight: 900; font-size: 17px; outline: none; color: #0f172a;">
            <button type="button" onclick="changeMasterProductQty(1)" style="border: none; background: #f1f5f9; width: 44px; height: 44px; font-weight: 900; font-size: 20px; cursor: pointer; color: #0f172a;">+</button>
          </div>
        </div>

        <!-- ADD TO CART CTA BUTTON -->
        <div>
          <button type="button" onclick="submitMasterProductAddToCart()" class="master-add-to-cart-btn" style="width: 100%; border: none; padding: 18px 32px; border-radius: 14px; font-weight: 900; font-size: 17px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 12px; transition: all 0.3s ease; box-shadow: 0 6px 20px rgba(0,0,0,0.12); {% if is_tshirt %}background: #A8D4B0; color: #143d1c;{% elsif is_sticker %}background: #F5AD72; color: #5E3106;{% elsif is_gift %}background: #A2D9F7; color: #073F61;{% else %}background: #0f172a; color: #ffffff;{% endif %}">
            <i class="fa-solid fa-cart-shopping" style="font-size: 18px;"></i> ADD TO CART
          </button>
        </div>

        <!-- Trust Perks Row -->
        <div style="display: flex; gap: 16px; margin-top: 6px; padding: 16px 0; border-top: 1px solid #f1f5f9; border-bottom: 1px solid #f1f5f9; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #475569;">
            <i class="fa-solid fa-truck-fast" style="color: #10B981; font-size: 15px;"></i> Free Delivery on ₹1,999+
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #475569;">
            <i class="fa-solid fa-shield-halved" style="color: #0284c7; font-size: 15px;"></i> Premium Quality Assured
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #475569;">
            <i class="fa-solid fa-bolt" style="color: #f59e0b; font-size: 15px;"></i> Fast Dispatch in 24h
          </div>
        </div>

        <!-- Accordions Section -->
        <div class="prod-accordions-group" style="display: flex; flex-direction: column; gap: 10px;">
          {% if is_tshirt %}
            <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; cursor: pointer;">
              <summary style="font-size: 14.5px; font-weight: 800; color: #0f172a; display: flex; align-items: center; justify-content: space-between; outline: none; list-style: none;">
                <span><i class="fa-solid fa-shirt" style="color: #A8D4B0; margin-right: 8px;"></i> Material & Fit</span>
                <span style="font-size: 13px; color: #64748b;">▼</span>
              </summary>
              <div style="margin-top: 12px; font-size: 13.5px; color: #475569; line-height: 1.65; font-weight: 500; border-top: 1px solid #f1f5f9; padding-top: 12px;">
                100% Super Combed Pure Cotton (180–240 GSM). Relaxed drop-shoulder oversized streetwear fit, bio-washed and pre-shrunk for zero shrinkage and ultra-soft comfort.
              </div>
            </details>

            <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; cursor: pointer;">
              <summary style="font-size: 14.5px; font-weight: 800; color: #0f172a; display: flex; align-items: center; justify-content: space-between; outline: none; list-style: none;">
                <span><i class="fa-solid fa-soap" style="color: #0284c7; margin-right: 8px;"></i> Wash & Care Guide</span>
                <span style="font-size: 13px; color: #64748b;">▼</span>
              </summary>
              <div style="margin-top: 12px; font-size: 13.5px; color: #475569; line-height: 1.65; font-weight: 500; border-top: 1px solid #f1f5f9; padding-top: 12px;">
                Machine wash cold inside-out with like colours. Use mild detergent. Do not bleach. Tumble dry low or hang dry. Do not iron directly on the printed artwork.
              </div>
            </details>
          {% elsif is_sticker %}
            <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; cursor: pointer;">
              <summary style="font-size: 14.5px; font-weight: 800; color: #0f172a; display: flex; align-items: center; justify-content: space-between; outline: none; list-style: none;">
                <span><i class="fa-solid fa-wand-magic-sparkles" style="color: #F5AD72; margin-right: 8px;"></i> How to Apply (Peel & Stick)</span>
                <span style="font-size: 13px; color: #64748b;">▼</span>
              </summary>
              <div style="margin-top: 12px; font-size: 13.5px; color: #475569; line-height: 1.65; font-weight: 500; border-top: 1px solid #f1f5f9; padding-top: 12px;">
                <strong>Step 1:</strong> Clean and dry your tumbler/mug thoroughly with rubbing alcohol.<br>
                <strong>Step 2:</strong> Peel the clear backing film from the transfer design.<br>
                <strong>Step 3:</strong> Align the decal and rub firmly from the center outwards to eliminate bubbles.<br>
                <strong>Step 4:</strong> Slowly and carefully peel the top transparent carrier film. Done!
              </div>
            </details>

            <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; cursor: pointer;">
              <summary style="font-size: 14.5px; font-weight: 800; color: #0f172a; display: flex; align-items: center; justify-content: space-between; outline: none; list-style: none;">
                <span><i class="fa-solid fa-droplet" style="color: #0284c7; margin-right: 8px;"></i> Waterproof & Durability</span>
                <span style="font-size: 13px; color: #64748b;">▼</span>
              </summary>
              <div style="margin-top: 12px; font-size: 13.5px; color: #475569; line-height: 1.65; font-weight: 500; border-top: 1px solid #f1f5f9; padding-top: 12px;">
                Printed with premium industrial UV DTF inks with a durable 3D gloss varnish. Completely waterproof, scratch-resistant, and dishwasher safe on top-rack.
              </div>
            </details>
          {% elsif is_gift %}
            <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; cursor: pointer;">
              <summary style="font-size: 14.5px; font-weight: 800; color: #0f172a; display: flex; align-items: center; justify-content: space-between; outline: none; list-style: none;">
                <span><i class="fa-solid fa-box" style="color: #A2D9F7; margin-right: 8px;"></i> Package Contents & Specs</span>
                <span style="font-size: 13px; color: #64748b;">▼</span>
              </summary>
              <div style="margin-top: 12px; font-size: 13.5px; color: #475569; line-height: 1.65; font-weight: 500; border-top: 1px solid #f1f5f9; padding-top: 12px;">
                Arrives packaged in a luxury matte black gift box with custom molded foam interior. Includes executive rollerball pen, stainless steel cardholder, metallic keychain, and leather-finish diary as per chosen gift combo.
              </div>
            </details>
          {% endif %}

          <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; cursor: pointer;">
            <summary style="font-size: 14.5px; font-weight: 800; color: #0f172a; display: flex; align-items: center; justify-content: space-between; outline: none; list-style: none;">
              <span><i class="fa-solid fa-clock-rotate-left" style="color: #64748b; margin-right: 8px;"></i> Delivery & Support</span>
              <span style="font-size: 13px; color: #64748b;">▼</span>
            </summary>
            <div style="margin-top: 12px; font-size: 13.5px; color: #475569; line-height: 1.65; font-weight: 500; border-top: 1px solid #f1f5f9; padding-top: 12px;">
              All orders are custom created and dispatched within 24–48 business hours with live tracking via Shiprocket. Need help? Contact our support team via WhatsApp anytime.
            </div>
          </details>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Size Chart Modal for T-Shirts -->
<div id="master-size-chart-modal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(15,23,42,0.7); backdrop-filter: blur(6px); align-items: center; justify-content: center; padding: 20px;">
  <div style="background: #ffffff; border-radius: 20px; max-width: 650px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 28px; position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    <button type="button" onclick="closeSizeChartModal()" style="position: absolute; top: 18px; right: 18px; background: #f1f5f9; border: none; width: 36px; height: 36px; border-radius: 50%; font-size: 18px; cursor: pointer; color: #64748b; display: flex; align-items: center; justify-content: center;">✕</button>
    <h3 style="font-size: 22px; font-weight: 900; color: #0f172a; margin: 0 0 16px;">T-Shirt Sizing Guide (Inches)</h3>
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; margin-bottom: 20px;">
      <thead>
        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
          <th style="padding: 12px; font-weight: 800; color: #0f172a;">Size</th>
          <th style="padding: 12px; font-weight: 800; color: #0f172a;">Chest (in)</th>
          <th style="padding: 12px; font-weight: 800; color: #0f172a;">Length (in)</th>
          <th style="padding: 12px; font-weight: 800; color: #0f172a;">Shoulder (in)</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom: 1px solid #f1f5f9;"><td style="padding: 10px 12px; font-weight: 800;">S</td><td style="padding: 10px 12px;">38"</td><td style="padding: 10px 12px;">28"</td><td style="padding: 10px 12px;">18.5"</td></tr>
        <tr style="border-bottom: 1px solid #f1f5f9;"><td style="padding: 10px 12px; font-weight: 800;">M</td><td style="padding: 10px 12px;">40"</td><td style="padding: 10px 12px;">29"</td><td style="padding: 10px 12px;">19.5"</td></tr>
        <tr style="border-bottom: 1px solid #f1f5f9;"><td style="padding: 10px 12px; font-weight: 800;">L</td><td style="padding: 10px 12px;">42"</td><td style="padding: 10px 12px;">30"</td><td style="padding: 10px 12px;">20.5"</td></tr>
        <tr style="border-bottom: 1px solid #f1f5f9;"><td style="padding: 10px 12px; font-weight: 800;">XL</td><td style="padding: 10px 12px;">44"</td><td style="padding: 10px 12px;">31"</td><td style="padding: 10px 12px;">21.5"</td></tr>
        <tr><td style="padding: 10px 12px; font-weight: 800;">2XL</td><td style="padding: 10px 12px;">46"</td><td style="padding: 10px 12px;">32"</td><td style="padding: 10px 12px;">22.5"</td></tr>
      </tbody>
    </table>
    <p style="font-size: 13px; color: #64748b; margin: 0; line-height: 1.5;">*Note: Measurements are taken when garment is laid flat. Allow +/- 0.5 inch standard tolerance.</p>
  </div>
</div>

<script>
  window.masterCurrentProduct = {
    id: {{ product.id | json }},
    title: {{ clean_title | json }},
    handle: {{ product.handle | json }},
    priceFormatted: {{ display_price | money | json }},
    priceNum: {{ display_price | json }},
    imgSrc: {{ product.featured_image | image_url: width: 800 | json }},
    isTshirt: {{ is_tshirt | json }},
    isSticker: {{ is_sticker | json }},
    isGift: {{ is_gift | json }},
    variants: {{ product.variants | json }}
  };

  let masterCurrentSize = 'M';
  let masterIncludeDrinkwareAddon = false;

  window.selectProductGalleryImg = function(imgSrc, thumbElem) {
    const mainImg = document.getElementById('master-prod-main-img');
    if (mainImg) mainImg.src = imgSrc;
    document.querySelectorAll('.prod-thumb-item').forEach(el => {
      el.style.borderColor = '#e2e8f0';
    });
    if (thumbElem) thumbElem.style.borderColor = '#0f172a';
  };

  window.selectMasterProductSize = function(size, btnElem) {
    masterCurrentSize = size;
    const label = document.getElementById('master-selected-size-label');
    if (label) label.textContent = size;

    document.querySelectorAll('.prod-size-chip').forEach(btn => {
      btn.style.background = '#ffffff';
      btn.style.color = '#334155';
      btn.style.borderColor = '#cbd5e1';
    });
    if (btnElem) {
      btnElem.style.background = '#A8D4B0';
      btnElem.style.color = '#143d1c';
      btnElem.style.borderColor = '#A8D4B0';
    }
  };

  window.changeMasterProductQty = function(delta) {
    const input = document.getElementById('master-prod-qty-input');
    if (!input) return;
    let val = parseInt(input.value) || 1;
    val = Math.max(1, Math.min(100, val + delta));
    input.value = val;
  };

  window.toggleDrinkwareAddon = function(type) {
    const cb = document.getElementById('addon-drinkware-checkbox');
    const box = document.getElementById('addon-drinkware-box');
    const appOpt = document.getElementById('addon-application-options');
    if (!cb) return;
    cb.checked = !cb.checked;
    masterIncludeDrinkwareAddon = cb.checked;

    if (cb.checked) {
      box.style.borderColor = '#F5AD72';
      box.style.background = '#fff7ed';
      if (appOpt) appOpt.style.display = 'block';
    } else {
      box.style.borderColor = '#e2e8f0';
      box.style.background = '#fafbfc';
      if (appOpt) appOpt.style.display = 'none';
    }
  };

  window.openSizeChartModal = function() {
    const modal = document.getElementById('master-size-chart-modal');
    if (modal) modal.style.display = 'flex';
  };

  window.closeSizeChartModal = function() {
    const modal = document.getElementById('master-size-chart-modal');
    if (modal) modal.style.display = 'none';
  };

  window.submitMasterProductAddToCart = function() {
    const p = window.masterCurrentProduct;
    if (!p) return;

    const qty = parseInt(document.getElementById('master-prod-qty-input')?.value) || 1;
    let selectedVariantId = null;

    // Variant matching for size if product has size variants
    if (p.isTshirt && p.variants && p.variants.length > 1) {
      for (let i = 0; i < p.variants.length; i++) {
        const v = p.variants[i];
        if (v.title.toLowerCase() === masterCurrentSize.toLowerCase() ||
            (v.option1 && v.option1.toLowerCase() === masterCurrentSize.toLowerCase())) {
          selectedVariantId = v.id;
          break;
        }
      }
    }

    if (!selectedVariantId && p.variants && p.variants.length > 0) {
      selectedVariantId = p.variants[0].id;
    }

    let finalTitle = p.title;
    let properties = {
      'Unit Price': p.priceFormatted
    };

    if (p.isTshirt) {
      finalTitle = `${p.title} (${masterCurrentSize})`;
      properties['Size'] = masterCurrentSize;
      properties['Type'] = 'In-Built Ready-Made';
    } else if (p.isGift) {
      const engInput = document.getElementById('master-gift-engraving-input');
      const engText = engInput ? engInput.value.trim() : '';
      if (engText) {
        properties['Engraved Name'] = engText;
        finalTitle = `${p.title} [Engraved: ${engText}]`;
      }
    }

    if (typeof handleAddToCart === 'function') {
      handleAddToCart({
        id: selectedVariantId || '{{ product.selected_or_first_available_variant.id }}',
        name: finalTitle,
        price: p.priceFormatted,
        img: p.imgSrc,
        quantity: qty,
        isInbuilt: !!p.isTshirt,
        properties: properties
      });

      // Handle Drinkware Add-on pairing if selected
      if (p.isSticker && masterIncludeDrinkwareAddon) {
        const appPref = document.querySelector('input[name="addon_app_pref"]:checked')?.value || 'Pre-Applied';
        const isTumbler = p.title.toLowerCase().includes('tumbler');
        const addonTitle = isTumbler ? '16oz Glass Tumbler with Bamboo Lid & Straw' : 'White Ceramic Coffee Mug (11oz)';
        const addonPrice = isTumbler ? '₹299.00' : '₹149.00';
        const addonId = isTumbler ? '67643948925060' : '67643948990596';
        const addonImg = isTumbler ? '{{ "tumbler-flow.png" | asset_url }}' : '{{ "mug-flow.png" | asset_url }}';

        setTimeout(() => {
          handleAddToCart({
            id: addonId,
            name: `${addonTitle} (${appPref})`,
            price: addonPrice,
            img: addonImg,
            quantity: qty,
            properties: {
              'Paired With': p.title,
              'Application': appPref,
              'Unit Price': addonPrice
            }
          });
        }, 350);
      }
    } else {
      // Direct Shopify cart API fallback
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: selectedVariantId || '{{ product.selected_or_first_available_variant.id }}',
            quantity: qty,
            properties: properties
          }]
        })
      }).then(r => r.json()).then(() => {
        if (window.openCartDrawer) window.openCartDrawer();
        else window.location.href = '/cart';
      });
    }
  };
</script>

<style>
  .master-add-to-cart-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.18) !important;
  }
  .prod-back-btn:hover {
    background: #e2e8f0 !important;
  }
  @media (max-width: 768px) {
    .master-prod-layout {
      gap: 25px !important;
    }
    .prod-gallery-wrapper {
      position: static !important;
    }
    .prod-main-image-card {
      padding: 16px !important;
    }
    .prod-main-image-card img {
      max-height: 360px !important;
    }
    .prod-details-col h1 {
      font-size: 24px !important;
    }
    #master-prod-price-display {
      font-size: 26px !important;
    }
  }
</style>

