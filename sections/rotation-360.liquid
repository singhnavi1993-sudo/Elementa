<!-- 360° Real-Time Rotation Banner Section -->
<section class="rotation-360-banner-section" id="rotation-360-{{ section.id }}">
  <div class="container">
    <div class="rotation-360-banner-card viewer-container-{{ section.id }}" id="viewerContainer-{{ section.id }}">
      
      <!-- Top Subtle Tag -->
      <div class="banner-top-badge">
        <span class="badge-dot"></span>
        <span>360° Real-Time 3D Studio</span>
      </div>

      <div class="viewport">
        <canvas id="view360Canvas-{{ section.id }}"></canvas>

        <!-- Bottom Pill Badge -->
        <div class="pill-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 3 10.07 19.97 12.58 12.58 19.97 10.07 3 3" fill="currentColor" fill-opacity="0.2"/>
          </svg>
          <span>{{ section.settings.badge_text | default: "Drag Left / Right to Rotate 360°" }}</span>
        </div>

        <!-- Loading Screen -->
        <div class="loading-overlay" id="loadingOverlay-{{ section.id }}">
          <div class="spinner"></div>
          <div class="loading-text" id="loadingText-{{ section.id }}">Loading 360° Frames 0%</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rotation-360-banner-section {
    padding: 35px 0 55px;
    background: #fdfaf6;
    position: relative;
    overflow: hidden;
  }

  .rotation-360-banner-section .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Compact Sleek Banner Card */
  .rotation-360-banner-card {
    position: relative;
    width: 100%;
    height: {{ section.settings.banner_height | default: "480px" }};
    background: radial-gradient(circle at center, #18181f 0%, #0a0a0c 100%);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Top badge indicator */
  .rotation-360-banner-card .banner-top-badge {
    position: absolute;
    top: 20px;
    left: 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 6px 14px;
    border-radius: 9999px;
    color: #e4e4e7;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    z-index: 15;
    pointer-events: none;
  }

  .rotation-360-banner-card .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
    display: inline-block;
  }

  /* Viewport fills the banner card */
  .rotation-360-banner-card .viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Hardware-accelerated canvas */
  .rotation-360-banner-card canvas {
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: grab;
    display: block;
  }

  .rotation-360-banner-card canvas:active {
    cursor: grabbing;
  }

  /* Bottom pill badge */
  .rotation-360-banner-card .pill-badge {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px;
    border-radius: 9999px;
    background: rgba(20, 20, 23, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    z-index: 20;
  }

  .rotation-360-banner-card .pill-badge svg {
    width: 13px;
    height: 13px;
    color: #f97316;
    transform: rotate(-10deg);
  }

  .rotation-360-banner-card .pill-badge span {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #e4e4e7;
  }

  /* Preloading spinner overlay */
  .rotation-360-banner-card .loading-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #0a0a0c;
    z-index: 50;
    transition: opacity 0.5s ease;
  }

  .rotation-360-banner-card .loading-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .rotation-360-banner-card .spinner {
    width: 38px;
    height: 38px;
    border: 3px solid rgba(249, 115, 22, 0.2);
    border-top-color: #f97316;
    border-radius: 50%;
    animation: spin-{{ section.id }} 0.8s linear infinite;
    margin-bottom: 12px;
  }

  @keyframes spin-{{ section.id }} {
    to { transform: rotate(360deg); }
  }

  .rotation-360-banner-card .loading-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a1a1aa;
  }

  @media (max-width: 900px) {
    .rotation-360-banner-card {
      height: 400px;
      border-radius: 20px;
    }
  }

  @media (max-width: 600px) {
    .rotation-360-banner-section {
      padding: 24px 0 36px;
    }
    .rotation-360-banner-section .container {
      padding: 0 12px;
    }
    .rotation-360-banner-card {
      height: 330px;
      border-radius: 16px;
    }
    .rotation-360-banner-card .banner-top-badge {
      top: 14px;
      left: 14px;
      font-size: 10px;
      padding: 4px 10px;
    }
    .rotation-360-banner-card .pill-badge {
      bottom: 14px;
      padding: 7px 14px;
    }
    .rotation-360-banner-card .pill-badge span {
      font-size: 9.5px;
    }
  }
</style>

<script>
  (function () {
    const TOTAL_FRAMES = {{ section.settings.total_frames | default: 50 }};
    const IMAGE_FOLDER = '{{ section.settings.image_folder | default: "/images/t-shirts" }}'; 
    const FRAME_PREFIX = '{{ section.settings.frame_prefix | default: "ezgif-frame-" }}';
    const FRAME_EXT = '{{ section.settings.frame_ext | default: ".jpg" }}';

    const container = document.getElementById('viewerContainer-{{ section.id }}');
    const canvas = document.getElementById('view360Canvas-{{ section.id }}');
    if (!canvas || !container) return;
    const ctx = canvas.getContext('2d', { alpha: false });
    const loadingOverlay = document.getElementById('loadingOverlay-{{ section.id }}');
    const loadingText = document.getElementById('loadingText-{{ section.id }}');

    const images = [];
    let loadedCount = 0;
    let isReady = false;

    // Linear Interpolation (Lerp)
    let currentFrame = 1;
    let targetFrame = 1;
    let lastDrawnFrame = -1;

    // Mouse & Touch Drag Support
    let isDragging = false;
    let startX = 0;
    let dragStartFrame = 1;

    const SHOPIFY_ASSET_TEMPLATE = {{ 'ezgif-frame-FRAME_NUM.jpg' | asset_url | json }};

    function getFrameUrl(idx) {
      const padded = String(idx).padStart(3, '0');
      if (IMAGE_FOLDER && (IMAGE_FOLDER.startsWith('http://') || IMAGE_FOLDER.startsWith('https://'))) {
        return `${IMAGE_FOLDER}/${FRAME_PREFIX}${padded}${FRAME_EXT}`;
      }
      if (SHOPIFY_ASSET_TEMPLATE && SHOPIFY_ASSET_TEMPLATE.indexOf('FRAME_NUM') !== -1) {
        return SHOPIFY_ASSET_TEMPLATE.replace('FRAME_NUM', padded);
      }
      return `${IMAGE_FOLDER}/${FRAME_PREFIX}${padded}${FRAME_EXT}`;
    }

    function drawFrame(frameIdx) {
      if (!isReady || !canvas) return;
      const w = canvas.width;
      const h = canvas.height;

      ctx.fillStyle = '#0e0e12';
      ctx.fillRect(0, 0, w, h);

      const img = images[frameIdx - 1];
      if (img && img.complete && img.naturalWidth > 0) {
        const imgAspect = img.width / img.height;
        const canvasAspect = w / h;

        let drawW, drawH, offX, offY;
        if (canvasAspect > imgAspect) {
          drawH = h;
          drawW = h * imgAspect;
          offX = (w - drawW) / 2;
          offY = 0;
        } else {
          drawW = w;
          drawH = w / imgAspect;
          offX = 0;
          offY = (h - drawH) / 2;
        }

        ctx.drawImage(img, offX, offY, drawW, drawH);
      } else {
        ctx.fillStyle = '#1e293b';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = '700 18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillStyle = '#f97316';
        ctx.fillText('360° Real-Time Rotation Banner', w / 2, h / 2 - 20);
        ctx.font = '500 12px ui-monospace, SFMono-Regular, monospace';
        ctx.fillStyle = '#94a3b8';
        ctx.fillText(`Frame ${frameIdx} of ${TOTAL_FRAMES}`, w / 2, h / 2 + 12);
      }
    }

    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const targetW = Math.round(rect.width * dpr);
      const targetH = Math.round(rect.height * dpr);

      if (canvas.width !== targetW || canvas.height !== targetH) {
        canvas.width = targetW;
        canvas.height = targetH;
      }

      drawFrame(Math.min(TOTAL_FRAMES, Math.max(1, Math.round(currentFrame))));
    }

    // Preload & decode all frames into memory
    for (let i = 1; i <= TOTAL_FRAMES; i++) {
      const img = new Image();
      img.src = getFrameUrl(i);

      const onDone = () => {
        loadedCount++;
        const percent = Math.round((loadedCount / TOTAL_FRAMES) * 100);
        if (loadingText) {
          loadingText.textContent = `Loading 360° Frames ${percent}%`;
        }

        if (loadedCount === TOTAL_FRAMES) {
          isReady = true;
          if (loadingOverlay) loadingOverlay.classList.add('hidden');
          resizeCanvas();
          drawFrame(1);
        }
      };

      if (img.decode) {
        img.decode().then(onDone).catch(onDone);
      } else {
        img.onload = onDone;
        img.onerror = onDone;
      }

      images.push(img);
    }

    window.addEventListener('resize', resizeCanvas);

    // Smooth Lerp loop
    function animate() {
      if (isReady) {
        const diff = targetFrame - currentFrame;
        if (Math.abs(diff) > 0.01) {
          currentFrame += diff * 0.18; // Silkiness factor
        } else {
          currentFrame = targetFrame;
        }

        let frameIdx = Math.round(currentFrame);
        frameIdx = Math.min(TOTAL_FRAMES, Math.max(1, frameIdx));

        if (frameIdx !== lastDrawnFrame) {
          drawFrame(frameIdx);
          lastDrawnFrame = frameIdx;
        }
      }
      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);

    // Natural Page Scroll Rotation: advances frames as the banner scrolls through viewport
    window.addEventListener('scroll', () => {
      if (!isReady || !container || isDragging) return;
      const rect = container.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;

      const totalTravel = vh + rect.height;
      const currentPos = vh - rect.top;
      const progress = Math.min(1, Math.max(0, currentPos / totalTravel));
      targetFrame = Math.round(progress * (TOTAL_FRAMES - 1)) + 1;
    }, { passive: true });

    // Drag to rotate (Desktop)
    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      dragStartFrame = targetFrame;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - startX;
      const deltaFrames = -Math.round(deltaX / 8);
      let next = ((dragStartFrame + deltaFrames - 1) % TOTAL_FRAMES) + 1;
      if (next < 1) next += TOTAL_FRAMES;
      targetFrame = next;
    });

    window.addEventListener('mouseup', () => { isDragging = false; });

    // Touch drag (Mobile)
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        startX = e.touches[0].clientX;
        dragStartFrame = targetFrame;
      }
    }, { passive: true });

    canvas.addEventListener('touchmove', (e) => {
      if (e.touches.length === 1) {
        const deltaX = e.touches[0].clientX - startX;
        const deltaFrames = -Math.round(deltaX / 8);
        let next = ((dragStartFrame + deltaFrames - 1) % TOTAL_FRAMES) + 1;
        if (next < 1) next += TOTAL_FRAMES;
        targetFrame = next;
      }
    }, { passive: true });

    canvas.addEventListener('touchend', () => { isDragging = false; });
  })();
</script>

{% schema %}
{
  "name": "360 Rotation Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Pill Badge Text",
      "default": "Drag Left / Right to Rotate 360°"
    },
    {
      "type": "text",
      "id": "banner_height",
      "label": "Banner Height",
      "default": "480px"
    },
    {
      "type": "number",
      "id": "total_frames",
      "label": "Total Frames",
      "default": 50
    },
    {
      "type": "text",
      "id": "image_folder",
      "label": "Image Folder URL",
      "default": "/images/t-shirts"
    },
    {
      "type": "text",
      "id": "frame_prefix",
      "label": "Frame Prefix",
      "default": "ezgif-frame-"
    },
    {
      "type": "text",
      "id": "frame_ext",
      "label": "Frame Extension",
      "default": ".jpg"
    }
  ],
  "presets": [
    {
      "name": "360 Rotation Banner"
    }
  ]
}
{% endschema %}
