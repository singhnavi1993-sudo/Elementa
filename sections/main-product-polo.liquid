    'oversized-navy.png': {{ 'oversized-navy.png' | asset_url | json }},
    'polo-black.jpg': {{ 'polo-black.jpg' | asset_url | json }},
    'polo-white.jpg': {{ 'polo-white.jpg' | asset_url | json }},
