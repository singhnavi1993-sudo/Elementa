                  </div>
                </div>
              </div>

            </div>

            <!-- Step 3: Logo Upload & Custom Text -->
            <div class="config-step">
              <label class="step-label">3. UPLOAD YOUR LOGO / ARTWORK</label>
              <div class="tshirt-upload-box" onclick="document.getElementById('tshirt-file-input-1').click()" style="border: 2px dashed #cbd5e1; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; background: #f8fafc; transition: all 0.2s ease; margin-top: 10px;">
                <i class="fa-solid fa-cloud-arrow-up" style="font-size: 32px; color: var(--primary-teal); margin-bottom: 8px;"></i>
                <div style="font-size: 14px; font-weight: 700; color: #1e293b;">Click to Upload Logo 1 (Front Print)</div>
                <div style="font-size: 12px; color: #64748b; margin-top: 4px;">Supports PNG, JPG, SVG, AI, PDF (Max 25MB)</div>
                <input type="file" id="tshirt-file-input-1" accept="image/*" style="display: none;" onchange="handleTshirtFileUploadNum(1, this)">
              </div>
            </div>

            <!-- Step 4: Authorization & Approval (Shown after adding logo in front or back) -->
            <div class="config-step" id="tshirt-auth-step-box" style="display: none; margin-top: 18px; background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 14px 16px;">
              <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer; user-select: none; font-size: 13px; font-weight: 700; color: #1e293b; line-height: 1.5;">
                <input type="checkbox" id="tshirt-auth-checkbox" onchange="toggleTshirtAddToCartState()" style="width: 20px; height: 20px; min-width: 20px; min-height: 20px; accent-color: #143d1c; margin-top: 1px; cursor: pointer;">
                <span>I have authorization to use the design, I have reviewed and approved it.</span>
              </label>
            </div>

            <!-- Add to Cart CTA -->
            <div class="config-step" style="margin-top: 25px;">
              <button type="button" id="btn-add-tshirt-cart" onclick="addTshirtToCart()" disabled="disabled" style="width: 100%; padding: 16px 24px; background: #94a3b8; color: #ffffff; border: none; border-radius: 999px; font-size: 16px; font-weight: 800; cursor: not-allowed; pointer-events: none; opacity: 0.45; filter: grayscale(0.6); transition: all 0.3s ease;">
                <i class="fa-solid fa-cart-shopping"></i> Add Custom Polo T-Shirts to Cart • ₹1,445.00
              </button>
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Customer Reviews Section -->
  {% render 'judgeme-review-widget', product: product %}
</div>

{% schema %}
{
  "name": "Polo T-Shirts",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "In-Built Products Collection"
    }
  ],
  "blocks": [
    {
      "type": "category_filter",
      "name": "Category Filter Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Oversized T-Shirts"
        },
        {
          "type": "text",
          "id": "filter_tag",
          "label": "Filter Tag / Keyword",
          "default": "oversized",
          "info": "Keyword to filter products by (e.g. oversized, graphic, polo, etc.)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Polo T-Shirts"
    }
  ]
}
{% endschema %}

<script>
  let currentSingleTshirtSize = 'M';
  let currentSingleProductData = null;

      window.openTshirtProductStudio = function(cardElem) {
    if (!cardElem) return;
    const card = cardElem.closest ? (cardElem.closest('.inbuilt-product-card') || cardElem) : cardElem;
    const title = card.querySelector('.inbuilt-card-title')?.textContent.trim() || 'Custom T-Shirt';
    const price = card.querySelector('.inbuilt-price-tag')?.textContent.trim() || '₹799.00';
    const category = card.querySelector('.inbuilt-card-category')?.textContent.trim() || 'Oversized T-Shirt';
    const imgSrc = card.querySelector('.inbuilt-card-media img')?.src || card.querySelector('img')?.src || '';

    const productData = { title, price, category, imgSrc };
    window.currentSingleProductData = productData;
    if (typeof currentSingleProductData !== 'undefined') {
      currentSingleProductData = productData;
    }

    const titleEl = document.getElementById('tshirt-single-title');
    const breadTitleEl = document.getElementById('tshirt-single-breadcrumb-title');
    const priceEl = document.getElementById('tshirt-single-price');
    const catEl = document.getElementById('tshirt-single-category');
    const imgEl = document.getElementById('tshirt-single-main-img');
    const qtyEl = document.getElementById('single-tshirt-qty-input');

    if (titleEl) titleEl.textContent = title;
    if (breadTitleEl) breadTitleEl.textContent = title;
    if (priceEl) priceEl.textContent = price;
    if (catEl) catEl.textContent = category;
    if (imgEl) imgEl.src = imgSrc;
    if (qtyEl) qtyEl.value = 1;

    const heroBanner = document.querySelector('.stickers-hero-banner');
    const inbuiltMode = document.getElementById('inbuilt-mode-view');
    const customMode = document.getElementById('custom-mode-view');
    const singleView = document.getElementById('single-product-mode-view');
    const extraSections = document.querySelectorAll('.size-chart-banner-section, .order-process-banner-section, .about-brand-section, .related-products-section');

    if (heroBanner) heroBanner.style.display = 'none';
    if (inbuiltMode) {
      inbuiltMode.style.display = 'none';
      inbuiltMode.classList.remove('active');
    }
    if (customMode) {
      customMode.style.display = 'none';
      customMode.classList.remove('active');
    }
    extraSections.forEach(sec => sec.style.display = 'none');

    if (singleView) {
      singleView.style.display = 'block';
      singleView.classList.add('active');
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
window.backToTshirtCatalog = function() {
    const heroBanner = document.querySelector('.stickers-hero-banner');
    const inbuiltMode = document.getElementById('inbuilt-mode-view');
    const customMode = document.getElementById('custom-mode-view');
    const singleView = document.getElementById('single-product-mode-view');
    const extraSections = document.querySelectorAll('.size-chart-banner-section, .order-process-banner-section, .about-brand-section, .related-products-section');

    if (heroBanner) heroBanner.style.display = 'block';
    if (singleView) {
      singleView.style.display = 'none';
      singleView.classList.remove('active');
    }
    if (customMode) {
      customMode.style.display = 'none';
      customMode.classList.remove('active');
    }
    extraSections.forEach(sec => sec.style.display = 'block');

    if (inbuiltMode) {
      inbuiltMode.style.display = 'block';
      inbuiltMode.classList.add('active');
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  window.selectSingleSize = function(size, btnElem) {
    currentSingleTshirtSize = size;
    document.querySelectorAll('.single-tshirt-size-chip').forEach(b => {
      b.style.background = '#ffffff';
      b.style.color = '#334155';
      b.style.borderColor = '#cbd5e1';
    });
    if (btnElem) {
      btnElem.style.background = '#A8D4B0';
      btnElem.style.color = '#143d1c';
      btnElem.style.borderColor = '#A8D4B0';
    }
  };

  window.changeSingleTshirtQty = function(delta) {
    const input = document.getElementById('single-tshirt-qty-input');
    if (!input) return;
    let val = parseInt(input.value) || 1;
    val = Math.max(1, val + delta);
    input.value = val;
  };

  window.addSingleTshirtToCart = function() {
    if (!currentSingleProductData) return;
    const qty = parseInt(document.getElementById('single-tshirt-qty-input').value) || 1;
    const p = currentSingleProductData;

    if (typeof handleAddToCart === 'function') {
      handleAddToCart({
        id: (document.querySelector('input[name="id"]')?.value || p.variantId || p.variants?.[0]?.id || '52875689427076'),
        name: `${p.title} (${currentSingleTshirtSize})`,
        price: p.price,
        img: p.imgSrc,
        quantity: qty
      });
    }
  };
</script>
