            <div onclick="openTshirtProductStudio(this)" class="inbuilt-product-card tilt-card reveal-on-scroll" data-category="{{ product.type | handleize | default: 'oversized' }}" style="cursor: pointer; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-sm); transition: transform 0.3s ease, box-shadow 0.3s ease; display: flex; flex-direction: column;">
              <div class="inbuilt-card-media" onclick="openTshirtProductStudio(this)" style="cursor: pointer; position: relative; height: 280px; overflow: hidden; cursor: pointer; background: #fdfaf6">
                
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: contain;">
              </div>
              <div class="inbuilt-card-body" style="padding: 18px; display: flex; flex-direction: column; flex: 1;">
                <span class="inbuilt-card-category" style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 4px;">{{ product.type | default: 'T-Shirt' }}</span>
                <h3 class="inbuilt-card-title" onclick="openTshirtProductStudio(this)" style="cursor: pointer; font-size: 15.5px; font-weight: 800; color: #0f172a; margin-bottom: 8px; line-height: 1.3">{{ product.title }}</h3>
                <div class="inbuilt-card-footer" style="margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px solid #f1f5f9;">
                  {% assign display_price = product.price %}
{% if display_price < 3000 %}
  {% assign p_lower = product.title | downcase %}
  {% if p_lower contains "hangry" or p_lower contains "naruto" or p_lower contains "one piece" or p_lower contains "pink panther" or p_lower contains "999" %}
  {% assign display_price = 99900 %}
{% elsif p_lower contains "hoodie" or p_lower contains "sweatshirt" %}
    {% assign display_price = 129900 %}
  {% elsif p_lower contains "oversiz" %}
    {% assign display_price = 79900 %}
  {% elsif p_lower contains "graphic" or p_lower contains "organic" or p_lower contains "dtg" %}
    {% assign display_price = 49900 %}
  {% elsif p_lower contains "round" %}
    {% assign display_price = 59900 %}
  {% elsif p_lower contains "polo" %}
    {% assign display_price = 62500 %}
  {% elsif p_lower contains "sticker" or p_lower contains "dtf" %}
    {% assign display_price = 15000 %}
  {% elsif p_lower contains "cap" %}
    {% assign display_price = 25000 %}
  {% elsif p_lower contains "gift" %}
    {% assign display_price = 24900 %}
  {% else %}
    {% assign display_price = 79900 %}
  {% endif %}
{% endif %}
                  <div class="inbuilt-price-tag" style="font-size: 18px; font-weight: 900; color: #0f172a;">{{ display_price | money }}</div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
</div>

