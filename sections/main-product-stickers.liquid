    <!-- Immediate Inbuilt Stickers Random Shuffle Across All Categories -->
    <script>
      (function() {
        try {
          var grid = document.getElementById('inbuilt-catalog-grid');
          if (!grid) return;
          var cards = Array.prototype.slice.call(grid.querySelectorAll('.inbuilt-product-card'));
          if (cards.length <= 1) return;
          for (var i = cards.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var temp = cards[i];
            cards[i] = cards[j];
            cards[j] = temp;
          }
          var frag = document.createDocumentFragment();
          for (var k = 0; k < cards.length; k++) {
            frag.appendChild(cards[k]);
          }
          grid.appendChild(frag);
          window.__inbuiltStickersShuffled = true;
        } catch (e) {
          console.warn('Inbuilt sticker shuffle error:', e);
        }
      })();
    </script>
