<script>
  (function() {
    try {
      var s = (window.location.search || '').toLowerCase();
      var h = (window.location.hash || '').toLowerCase();
      if (s.indexOf('mode=custom') !== -1 || s.indexOf('tab=custom') !== -1 || h.indexOf('custom') !== -1) {
        document.documentElement.classList.add('preload-sticker-custom');
      }
    } catch(e) {}
  })();
</script>
<style>
  html.preload-sticker-custom #inbuilt-mode-view { display: none !important; }
  html.preload-sticker-custom #custom-mode-view { display: block !important; }
  html.preload-sticker-custom #tab-btn-inbuilt { background: transparent !important; color: var(--dark-main) !important; }
  html.preload-sticker-custom #tab-btn-custom { background: #A8D4B0 !important; color: #143d1c !important; }
