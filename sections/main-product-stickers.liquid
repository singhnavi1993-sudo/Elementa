<script>
  (function() {
    function cleanStr(s) {
      return (s || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    }

    function autoOpenStickerProductFromUrl() {
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const catParam = (urlParams.get('cat') || '').toLowerCase().trim();
        const prodParam = (urlParams.get('product') || urlParams.get('open_product') || '').toLowerCase().trim();
        const titleParam = (urlParams.get('title') || urlParams.get('open_title') || '').toLowerCase().trim();

        if (!catParam && !prodParam && !titleParam) return;

        // 1. Ensure In-Built Products view is active
        if (typeof window.switchStickerMode === 'function') {
          window.switchStickerMode('inbuilt');
        }

        // 2. Filter category if specified
        if (catParam === 'tumbler' || catParam === 'mug') {
          const chipBtn = document.querySelector(`.inbuilt-chip-btn[onclick*="${catParam}"]`);
          if (typeof window.filterInbuiltMainCategory === 'function') {
            window.filterInbuiltMainCategory(catParam, chipBtn);
          }
        }

        if (!prodParam && !titleParam) return;

        const grid = document.getElementById('inbuilt-catalog-grid');
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll('.inbuilt-product-card'));
        if (cards.length === 0) {
          setTimeout(autoOpenStickerProductFromUrl, 150);
          return;
        }

        const normProd = cleanStr(prodParam);
        const normTitle = cleanStr(titleParam);

        let matchedCard = null;

        // Pass 1: Try matching strictly within requested category if available
        for (const card of cards) {
          const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
          if (catParam && cardCat && !cardCat.includes(catParam) && !catParam.includes(cardCat)) {
            continue;
          }
          const cardHandle = cleanStr(card.getAttribute('data-handle') || card.getAttribute('data-product-handle'));
          const cardTitle = cleanStr(card.getAttribute('data-title') || card.querySelector('.inbuilt-card-title')?.textContent);

          if (normProd && cardHandle && (cardHandle === normProd || cardHandle.includes(normProd) || normProd.includes(cardHandle))) {
            matchedCard = card;
            break;
          }
          if (normTitle && cardTitle && (cardTitle === normTitle || cardTitle.includes(normTitle) || normTitle.includes(cardTitle))) {
            matchedCard = card;
            break;
          }
        }

        // Pass 2: Relax category filter if not found
        if (!matchedCard) {
          for (const card of cards) {
            const cardHandle = cleanStr(card.getAttribute('data-handle') || card.getAttribute('data-product-handle'));
            const cardTitle = cleanStr(card.getAttribute('data-title') || card.querySelector('.inbuilt-card-title')?.textContent);

            if (normProd && cardHandle && (cardHandle === normProd || cardHandle.includes(normProd) || normProd.includes(cardHandle))) {
              matchedCard = card;
              break;
            }
            if (normTitle && cardTitle && (cardTitle === normTitle || cardTitle.includes(normTitle) || normTitle.includes(cardTitle))) {
              matchedCard = card;
              break;
            }
          }
        }

        // 3. Open modal on matched card
        if (matchedCard) {
          matchedCard.style.display = 'flex';
          setTimeout(function() {
            if (typeof window.openInbuiltStickerModal === 'function') {
              window.openInbuiltStickerModal(matchedCard);
              matchedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }, 120);
        }
      } catch (err) {
        console.warn('Auto-open sticker error:', err);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(autoOpenStickerProductFromUrl, 250);
      });
    } else {
      setTimeout(autoOpenStickerProductFromUrl, 250);
    }
  })();
</script>

