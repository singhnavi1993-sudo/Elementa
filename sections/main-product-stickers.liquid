<!-- Hero Banner Section (#F5AD72 Background) -->
<section class="stickers-hero-banner" style="background: #F5AD72; padding: 45px 0 35px; text-align: center; color: #1e272e;">
  <div class="container">
    <div class="sticker-mode-header-text">
      <h1 style="font-size: 38px; font-weight: 900; margin-bottom: 8px; color: #ffffff; text-shadow: 0 2px 10px rgba(0,0,0,0.12);">Stickers</h1>
      <p style="font-size: 16px; font-weight: 600; opacity: 0.95; margin-bottom: 25px; color: #ffffff;">Shop our Design or Customize your own</p>
    </div>

    <!-- Mode Selector Bar (#A8D4B0 highlight when active) -->
    <div class="sticker-mode-bar" style="display: inline-flex; background: rgba(255, 255, 255, 0.95); padding: 6px; border-radius: 999px; box-shadow: 0 8px 25px rgba(0,0,0,0.12); gap: 6px;">
      <button type="button" class="mode-tab-btn active" id="tab-btn-inbuilt" onclick="switchStickerMode('inbuilt')" style="padding: 12px 28px; border-radius: 999px; font-weight: 800; font-size: 14px; border: none; cursor: pointer; transition: all 0.3s ease; background: #A8D4B0; color: #143d1c;">
        <i class="fa-solid fa-boxes-packing"></i> In-Built Products
      </button>
      <button type="button" class="mode-tab-btn" id="tab-btn-custom" onclick="switchStickerMode('custom')" style="padding: 12px 28px; border-radius: 999px; font-weight: 800; font-size: 14px; border: none; cursor: pointer; transition: all 0.3s ease; background: transparent; color: var(--dark-main);">
        <i class="fa-solid fa-sliders"></i> Customized Products
      </button>
    </div>
  </div>
</section>

