<div class="about-us-page-wrapper">
  <style>
    /* About Us Liquid Section Styles */
    .about-hero-section {
      background: linear-gradient(180deg, #FAF8F5 0%, #F4EFE6 100%);
      padding: 70px 0 80px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .about-hero-title {
      font-size: clamp(30px, 4.5vw, 48px);
      font-weight: 800;
      color: #0f172a;
      line-height: 1.25;
      letter-spacing: -0.6px;
      margin: 0 auto 22px;
      max-width: 820px;
      text-transform: none;
    }
    .about-hero-desc {
      font-size: 16.5px;
      line-height: 1.7;
      color: #475569;
      max-width: 820px;
      margin: 0 auto;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(226, 232, 240, 0.8);
      padding: 30px 36px;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }
    .why-section {
      padding: 90px 0;
      background: #ffffff;
    }
    .section-label {
      font-size: 12.5px;
      font-weight: 800;
      color: #10B981;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
      display: block;
    }
    .section-title {
      font-size: clamp(26px, 3.8vw, 42px);
      font-weight: 900;
      color: #0f172a;
      letter-spacing: -0.8px;
      margin-bottom: 18px;
    }
    .why-intro-text {
      font-size: 17px;
      line-height: 1.75;
      color: #334155;
      max-width: 860px;
      margin-bottom: 50px;
    }
    .three-points-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }
    @media (min-width: 768px) {
      .three-points-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .point-card {
      background: #FAF8F5;
      border: 1.5px solid #e2e8f0;
      border-radius: 18px;
      padding: 36px 28px;
      transition: all 0.3s ease;
    }
    .point-card:hover {
      transform: translateY(-6px);
      border-color: #10B981;
      box-shadow: 0 14px 35px rgba(16, 185, 129, 0.1);
    }
    .point-number {
      font-size: 13px;
      font-weight: 900;
      color: #ffffff;
      background: #10B981;
      padding: 4px 12px;
      border-radius: 999px;
      display: inline-block;
      margin-bottom: 18px;
    }
    .point-title {
      font-size: 20px;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 10px;
      letter-spacing: -0.3px;
    }
    .point-desc {
      font-size: 15px;
      color: #64748b;
      line-height: 1.6;
      margin: 0;
    }
    .what-we-make-section {
      padding: 90px 0;
      background: #FAF8F5;
      border-top: 1px solid #e2e8f0;
      border-bottom: 1px solid #e2e8f0;
    }
    .make-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 48px;
    }
    @media (max-width: 1023px) {
      .make-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 767px) {
      .what-we-make-section {
        padding: 40px 0 45px !important;
      }
      .make-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px !important;
        margin-bottom: 24px !important;
      }
      .make-card {
        padding: 16px 12px 14px !important;
        border-radius: 14px !important;
      }
      .make-icon-wrap {
        width: 38px !important;
        height: 38px !important;
        font-size: 17px !important;
        border-radius: 10px !important;
        margin-bottom: 12px !important;
      }
      .make-card-title {
        font-size: 13.5px !important;
        margin-bottom: 4px !important;
      }
      .make-card-details {
        font-size: 11px !important;
        line-height: 1.35 !important;
      }
      .for-you-tagline {
        font-size: 13.5px !important;
        margin-bottom: 22px !important;
      }
      .customize-cta-box {
        padding: 24px 16px !important;
        border-radius: 18px !important;
      }
      .cta-heading {
        font-size: 18px !important;
        line-height: 1.3 !important;
        margin-bottom: 16px !important;
      }
      .cta-btn {
        padding: 12px 24px !important;
        font-size: 13px !important;
      }
    }
    @media (max-width: 360px) {
      .make-grid {
        gap: 8px !important;
      }
      .make-card {
        padding: 12px 8px 10px !important;
        border-radius: 12px !important;
      }
      .make-icon-wrap {
        width: 34px !important;
        height: 34px !important;
        font-size: 15px !important;
        margin-bottom: 8px !important;
      }
      .make-card-title {
        font-size: 12px !important;
      }
      .make-card-details {
        font-size: 10px !important;
      }
    }
    .make-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.3s ease;
      text-decoration: none;
    }
    .make-card:hover {
      border-color: #0f172a;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
      transform: translateY(-4px);
    }
    .make-icon-wrap {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: rgba(16, 185, 129, 0.1);
      color: #10B981;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      margin-bottom: 20px;
    }
    .make-card-title {
      font-size: 18px;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 8px;
    }
    .make-card-details {
      font-size: 14px;
      color: #64748b;
      line-height: 1.5;
      margin: 0;
    }
    .for-you-tagline {
      text-align: center;
      font-size: 18px;
      font-weight: 800;
      color: #334155;
      margin-bottom: 30px;
    }
    .customize-cta-box {
      background: #0f172a;
      color: #ffffff;
      border-radius: 24px;
      padding: 48px 36px;
      text-align: center;
      max-width: 840px;
      margin: 0 auto;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.15);
    }
    .cta-heading {
      font-size: clamp(22px, 3.5vw, 32px);
      font-weight: 900;
      margin-bottom: 24px;
    }
    .cta-btn {
      background: #10B981;
      color: #ffffff;
      padding: 16px 38px;
      border-radius: 999px;
      font-weight: 900;
      font-size: 15.5px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.3s ease;
    }
    .cta-btn:hover {
      background: #059669;
      transform: scale(1.05);
      color: #ffffff;
    }
    .founder-section {
      padding: 100px 0 110px;
      background: #ffffff;
    }
    .founder-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 50px;
      align-items: center;
    }
    @media (min-width: 992px) {
      .founder-layout {
        grid-template-columns: 0.9fr 1.1fr;
        gap: 70px;
      }
    }
    .founder-img-wrapper {
      position: relative;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.08);
      border: 4px solid #FAF8F5;
      background: #FAF8F5;
    }
    .founder-img {
      width: 100%;
      height: auto;
      max-height: 650px;
      object-fit: contain;
      display: block;
      transition: transform 0.4s ease;
      background: #FAF8F5;
    }
    .founder-badge {
      margin: 14px 16px 16px;
      background: #0f172a;
      color: #ffffff;
      padding: 14px 20px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .founder-name {
      font-size: 17px;
      font-weight: 900;
      margin: 0;
      color: #ffffff;
    }
    .founder-title-text {
      font-size: 13px;
      color: #10B981;
      font-weight: 700;
      margin: 0;
    }
    .founder-content {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .founder-section-tag {
      font-size: 13px;
      font-weight: 900;
      color: #10B981;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .founder-heading {
      font-size: clamp(24px, 3.2vw, 36px);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.25;
      margin: 0;
    }
    .founder-paragraph {
      font-size: 16px;
      line-height: 1.75;
      color: #475569;
      margin: 0;
    }
    .founder-quote-highlight {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      border-left: 4px solid #10B981;
      padding-left: 20px;
      margin: 10px 0;
      line-height: 1.6;
    }
    .founder-sign-off {
      margin-top: 15px;
      font-size: 20px;
      font-weight: 900;
      color: #0f172a;
      font-style: italic;
    }
  </style>

  <!-- 01 HERO SECTION -->
  <section class="about-hero-section">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
      <span class="section-label">ABOUT ELEMENTA</span>
      <h1 class="about-hero-title">Making customization feel a little less complicated.</h1>
      <div class="about-hero-desc">
        <p style="margin:0;">
          Elementa is a customization-first brand built to make creating something of your own feel simple. 
          From T-shirts and stickers to caps and personalised gifts, you can choose from our designs or bring your own idea to life. 
          Whether it’s something for yourself, a gift for someone special, or merchandise for your business, we’re here to help make it yours.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 WHY ELEMENTA EXISTS -->
  <section class="why-section">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
      <span class="section-label">THE STORY</span>
      <h2 class="section-title">WHY ELEMENTA EXISTS</h2>
      <p class="why-intro-text">
        It started with one simple question: <strong>Why does ordering something customized still feel so complicated?</strong><br><br>
        Too much back and forth. Too many decisions. And often, too much uncertainty around what you're actually going to receive. 
        Elementa was created to make that experience clearer, easier and more enjoyable — from choosing your product to seeing your idea come to life.
      </p>

      <div class="three-points-grid">
        <div class="point-card">
          <span class="point-number">STEP 01</span>
          <h3 class="point-title">CHOOSE IT</h3>
          <p class="point-desc">Start with one of our designs or curated product blanks.</p>
        </div>

        <div class="point-card">
          <span class="point-number">STEP 02</span>
          <h3 class="point-title">MAKE IT YOURS</h3>
          <p class="point-desc">Add your design, name, text or logo with instant proofing.</p>
        </div>

        <div class="point-card">
          <span class="point-number">STEP 03</span>
          <h3 class="point-title">WE MAKE IT TANGIBLE</h3>
          <p class="point-desc">We take care of the rest — high definition print &amp; fast delivery.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 WHAT WE MAKE -->
  <section class="what-we-make-section">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
      <div style="text-align: center; margin-bottom: 45px;">
        <span class="section-label">OUR CATALOG</span>
        <h2 class="section-title">WHAT WE MAKE</h2>
      </div>

      <div class="make-grid">
        <a href="/pages/t-shirts" class="make-card">
          <div class="make-icon-wrap"><i class="fa-solid fa-shirt"></i></div>
          <div>
            <h3 class="make-card-title">T-SHIRTS</h3>
            <p class="make-card-details">Oversized · Round Neck · Polos</p>
          </div>
        </a>

        <a href="/pages/stickers" class="make-card">
          <div class="make-icon-wrap"><i class="fa-solid fa-note-sticky"></i></div>
          <div>
            <h3 class="make-card-title">STICKERS</h3>
            <p class="make-card-details">Standard · Vinyl · Transparent · UV DTF Transfers</p>
          </div>
        </a>

        <a href="/products/caps" class="make-card">
          <div class="make-icon-wrap"><i class="fa-solid fa-hat-cowboy"></i></div>
          <div>
            <h3 class="make-card-title">CAPS</h3>
            <p class="make-card-details">Text · Designs · Logos</p>
          </div>
        </a>

        <a href="/pages/gifts" class="make-card">
          <div class="make-icon-wrap"><i class="fa-solid fa-gift"></i></div>
          <div>
            <h3 class="make-card-title">GIFTING</h3>
            <p class="make-card-details">Personal · Corporate</p>
          </div>
        </a>
      </div>

      <p class="for-you-tagline">For you. For someone you love. For your business.</p>

      <div class="customize-cta-box">
        <h3 class="cta-heading">Have something in mind? Let’s make it tangible.</h3>
        <a href="/#calculator" class="cta-btn">
          <span>[ CUSTOMIZE YOURS ]</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 04 A NOTE FROM THE FOUNDER -->
  <section class="founder-section">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
      <div class="founder-layout">
        
        <!-- Founder Image -->
        <div class="founder-img-wrapper">
          <img src="https://cdn.shopify.com/s/files/1/1021/4352/4996/files/founder-priya-elementa-sign.jpg?v=1791495347" alt="Priya - Founder of Elementa" class="founder-img">
          <div class="founder-badge">
            <div>
              <p class="founder-name">Priya</p>
              <p class="founder-title-text">Founder</p>
            </div>
            <span style="background: #10B981; width: 10px; height: 10px; border-radius: 50%;"></span>
          </div>
        </div>

        <!-- Founder Letter Content -->
        <div class="founder-content">
          <span class="founder-section-tag">A NOTE FROM THE FOUNDER</span>
          <h2 class="founder-heading">Why does getting something customized still feel so complicated?</h2>
          
          <p class="founder-paragraph">
            That was the question I kept coming back to. Finding the right product, explaining your idea, going back and forth, wondering how it'll turn out. 
            Something that's meant to feel personal can quickly start feeling like a tedious process.
          </p>

          <p class="founder-paragraph">
            I wanted to make it simpler. So I built <strong>Elementa</strong> — a place where you can choose something you love or make it completely your own, without the usual back and forth.
          </p>

          <div class="founder-quote-highlight">
            From T-shirts and stickers to caps and gifts, the idea is simple: you bring the idea, and we help make it tangible.
          </div>

          <p class="founder-paragraph" style="font-weight: 700; color: #0f172a;">
            That's Elementa. Your ideas, made tangible.
          </p>

          <div class="founder-sign-off">
            — love, Priya
          </div>
        </div>

      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Main About Us",
  "settings": [
    {
      "type": "image_picker",
      "id": "founder_img",
      "label": "Founder Photo"
    }
  ],
  "presets": [
    {
      "name": "Main About Us"
    }
  ]
}
{% endschema %}
