  {% elsif p_lower contains "cap" %}
    {% assign display_price = 25000 %}
  {% elsif p_lower contains "gift" %}
    {% assign display_price = 24900 %}
  {% else %}
    {% assign display_price = 79900 %}
  {% endif %}
{% endif %}
                  <div class="product-price" style="font-size: 19px; font-weight: 900; color: #0f172a; white-space: nowrap;">{{ display_price | money }}</div>
                  </div>
                  <a href="{{ card_redirect_url }}" class="product-explore-btn" style="background: #A8D4B0; color: #17401F;">
                    <span>Explore Product</span> <i class="fa-solid fa-arrow-right" style="font-size: 12px;"></i>
                  </a>
                </div>
              </div>
            </div>
          {% endif %}
        {% endif %}
