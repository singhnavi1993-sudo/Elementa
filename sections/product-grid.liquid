<section class="product-tabs-section" id="elementa-picks" style="padding: 90px 0; background: linear-gradient(180deg, #FAFBFD 0%, #F4F7FB 100%); position: relative; overflow: hidden;">
  <!-- Parallax Floating Ambient Elements -->
  <div class="parallax-floating-layer" data-speed="0.22" style="position: absolute; top: 5%; right: -60px; width: 350px; height: 350px; background: radial-gradient(circle, rgba(245,173,114,0.15) 0%, rgba(245,173,114,0) 70%); border-radius: 50%; pointer-events: none; filter: blur(50px);"></div>
  <div class="parallax-floating-layer" data-speed="-0.18" style="position: absolute; bottom: 8%; left: -80px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(162,217,247,0.18) 0%, rgba(162,217,247,0) 70%); border-radius: 50%; pointer-events: none; filter: blur(60px);"></div>
  <div class="parallax-floating-layer" data-speed="0.12" style="position: absolute; top: 45%; right: 10%; width: 220px; height: 220px; background: radial-gradient(circle, rgba(168,212,176,0.15) 0%, rgba(168,212,176,0) 70%); border-radius: 50%; pointer-events: none; filter: blur(40px);"></div>

  <div class="container" style="position: relative; z-index: 2;">
    <div class="section-header" style="text-align: center; margin-bottom: 45px;">
      <span class="section-subtitle" style="background: rgba(245,173,114,0.18); color: #D66D25; padding: 8px 22px; border-radius: 999px; font-weight: 800; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(245,173,114,0.35); box-shadow: 0 4px 15px rgba(245,173,114,0.15);">
        <i class="fa-solid fa-fire-flame-curved" style="color: #F5AD72;"></i> elementa picks
      </span>
      <h2 class="section-title product-grid-main-title">{% if section.settings.title != blank and section.settings.title != 'Trending Custom Creations' %}{{ section.settings.title }}{% else %}Made To Be Yours{% endif %}</h2>
      <p class="product-grid-subtext">choose one of our designs or customize it your way</p>

      <!-- Category Filter Pills -->
      <div class="product-filter-pills" style="display: flex; justify-content: center; gap: 12px; margin-top: 28px; flex-wrap: wrap;">
        <button type="button" class="tab-btn filter-pill active" data-category="all" onclick="filterHomeCategory('all', this)" style="padding: 9px 22px; border-radius: 999px; background: #0f172a; color: #ffffff; border: 1.5px solid #0f172a; font-size: 13.5px; font-weight: 700; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 14px rgba(15,23,42,0.2);">All Products</button>
        <button type="button" class="tab-btn filter-pill" data-category="tshirts" onclick="filterHomeCategory('tshirts', this)" style="padding: 9px 22px; border-radius: 999px; background: #ffffff; color: #475569; border: 1.5px solid rgba(168,212,176,0.6); font-size: 13.5px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;">
          <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #A8D4B0; margin-right: 6px;"></span>T-Shirts
        </button>
        <button type="button" class="tab-btn filter-pill" data-category="tumbler" onclick="filterHomeCategory('tumbler', this)" style="padding: 9px 22px; border-radius: 999px; background: #ffffff; color: #475569; border: 1.5px solid rgba(245,173,114,0.6); font-size: 13.5px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;">
          <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #F5AD72; margin-right: 6px;"></span>Tumbler
        </button>
        <button type="button" class="tab-btn filter-pill" data-category="mugs" onclick="filterHomeCategory('mugs', this)" style="padding: 9px 22px; border-radius: 999px; background: #ffffff; color: #475569; border: 1.5px solid rgba(162,217,247,0.6); font-size: 13.5px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;">
          <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #A2D9F7; margin-right: 6px;"></span>Mugs
        </button>
        <button type="button" class="tab-btn filter-pill" data-category="gifts" onclick="filterHomeCategory('gifts', this)" style="padding: 9px 22px; border-radius: 999px; background: #ffffff; color: #475569; border: 1.5px solid rgba(178,180,179,0.6); font-size: 13.5px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;">
          <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #B2B4B3; margin-right: 6px;"></span>Gifts
        </button>
      </div>
    </div>

    <!-- Dynamic Shopify Product Grid -->
    <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 30px;">
      {% assign target_prods = collections['all'].products %}
      {% if target_prods == blank or target_prods.size == 0 %}
        {% assign target_prods = collections['frontpage'].products %}
      {% endif %}

      {% comment %} PASS 1: Interleaved 2 T-Shirts, 2 Tumblers, 2 Mugs, 2 Gifts (8 Total for ALL PRODUCTS view) {% endcomment %}
      
      {% comment %} 1. First 2 T-Shirts (Featured First) {% endcomment %}
      {% assign t_count = 0 %}
      {% assign t_featured_handles = '' %}
      
      {% for product in target_prods %}
        {% if t_count >= 2 %}{% break %}{% endif %}
        {% assign p_h = product.handle | downcase %}
        {% assign p_t = product.title | downcase %}
        {% assign p_tp = product.type | downcase %}
        {% assign p_tg = product.tags | join: ',' | downcase %}
        
        {% if p_h == 'custom-polo' or p_h == 'custom-oversized' or p_t contains 'custom polo' or p_t contains 'custom oversized' or p_tg contains 'hidden-home' or p_tg contains 'hidden' %}
          {% continue %}
        {% endif %}
        
        {% if p_tg contains 'featured-home' or p_tg contains 'featured' %}
          {% if p_t contains 'shirt' or p_t contains 'tee' or p_tp contains 'shirt' or p_tg contains 'shirt' or p_tg contains 't-shirt' or p_tg contains 'oversized' %}
            {% assign t_count = t_count | plus: 1 %}
            {% assign t_featured_handles = t_featured_handles | append: p_h | append: ',' %}
            
            {% assign encoded_title = product.title | url_encode %}
            {% assign card_redirect_url = '/pages/t-shirts?product=' | append: product.handle | append: '&title=' | append: encoded_title %}
            <div class="product-card tilt-card" data-category="tshirts" data-in-all="true" onclick="if (!event.target.closest('a')) { window.location.href='{{ card_redirect_url }}'; }" style="cursor: pointer; background: #ffffff; border: 1.5px solid rgba(168,212,176,0.35); border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(15,23,42,0.06); transition: all 0.35s ease; display: flex; flex-direction: column; position: relative;">
              <div style="position: absolute; top: 14px; left: 14px; z-index: 3; background: #A8D4B0; color: #17401F; font-size: 11px; font-weight: 800; padding: 4px 12px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.6px;">T-Shirts</div>
              <div class="product-thumb" style="position: relative; height: 260px; overflow: hidden; cursor: pointer; background: #fafbfc; display: flex; align-items: center; justify-content: center; padding: 16px;">
                <a href="{{ card_redirect_url }}" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; text-decoration: none;"><img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" style="max-width: 100%; max-height: 100%; object-fit: contain; transition: transform 0.5s ease;"></a>
              </div>
              <div class="product-info" style="padding: 22px; display: flex; flex-direction: column; flex: 1; background: #ffffff;">
                <h3 class="product-name" style="font-size: 16.5px; font-weight: 800; color: #0f172a; margin-bottom: 12px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 44px;">
                  <a href="{{ card_redirect_url }}" style="color: inherit; text-decoration: none;">{{ product.title | replace: 'Trasfer', 'Transfer' | replace: 'trasfer', 'transfer' }}</a>
                </h3>
                <div class="product-card-bottom" style="margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-top: 14px; border-top: 1px dashed #e2e8f0;">
                  <div class="product-price-col">
                    <span style="font-size: 11px; text-transform: uppercase; color: #94a3b8; font-weight: 700; display: block; margin-bottom: 2px;">Starting at</span>
                    {% assign display_price = product.price %}
{% if display_price < 3000 %}
  {% assign p_lower = product.title | downcase %}
  {% if p_lower contains "hangry" or p_lower contains "naruto" or p_lower contains "one piece" or p_lower contains "pink panther" or p_lower contains "999" %}
  {% assign display_price = 99900 %}
{% elsif p_lower contains "hoodie" or p_lower contains "sweatshirt" %}
    {% assign display_price = 129900 %}
  {% elsif p_lower contains "oversiz" %}
    {% assign display_price = 79900 %}
  {% elsif p_lower contains "graphic" or p_lower contains "organic" or p_lower contains "dtg" %}
    {% assign display_price = 49900 %}
  {% elsif p_lower contains "round" %}
    {% assign display_price = 59900 %}
  {% elsif p_lower contains "polo" %}
    {% assign display_price = 62500 %}
  {% elsif p_lower contains "sticker" or p_lower contains "dtf" %}
