<script>
  function filterHomeCategory(category, buttonEl) {
    var section = (buttonEl && buttonEl.closest('.product-tabs-section')) || document.querySelector('.product-tabs-section');
    if (!section) return;

    var pills = section.querySelectorAll('.product-filter-pills .filter-pill');
    pills.forEach(function(pill) {
      pill.classList.remove('active');
      pill.style.background = '#ffffff';
      pill.style.color = '#475569';
      pill.style.boxShadow = 'none';
      var cat = pill.getAttribute('data-category');
      if (cat === 'tshirts') pill.style.borderColor = 'rgba(168,212,176,0.6)';
      else if (cat === 'tumbler') pill.style.borderColor = 'rgba(245,173,114,0.6)';
      else if (cat === 'mugs') pill.style.borderColor = 'rgba(162,217,247,0.6)';
      else if (cat === 'gifts') pill.style.borderColor = 'rgba(178,180,179,0.6)';
      else pill.style.borderColor = '#e2e8f0';
    });

    var activePill = buttonEl || section.querySelector('.product-filter-pills .filter-pill[data-category="' + category + '"]');
    if (activePill) {
      activePill.classList.add('active');
      activePill.style.background = '#0f172a';
      activePill.style.color = '#ffffff';
      activePill.style.borderColor = '#0f172a';
      activePill.style.boxShadow = '0 4px 14px rgba(15,23,42,0.2)';
    }

    var cards = section.querySelectorAll('.product-grid .product-card');
    cards.forEach(function(card) {
      var cardCat = card.getAttribute('data-category');
      var inAll = card.getAttribute('data-in-all') === 'true';

      if (category === 'all') {
        if (inAll) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      } else {
        if (cardCat === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      }
    });
  }

  window.filterHomeCategory = filterHomeCategory;

  window.initProductTabs = function() {
    var section = document.querySelector('.product-tabs-section');
    if (!section) return;
    var pills = section.querySelectorAll('.product-filter-pills .filter-pill');
    pills.forEach(function(pill) {
      pill.addEventListener('click', function(e) {
        e.preventDefault();
        var cat = this.getAttribute('data-category') || 'all';
        filterHomeCategory(cat, this);
      });
    });
  };

  document.addEventListener('DOMContentLoaded', function() {
    if (typeof window.initProductTabs === 'function') {
      window.initProductTabs();
    }
  });
</script>

